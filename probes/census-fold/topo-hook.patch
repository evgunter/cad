+//! SCRATCH measurement hook (census-fold lane) — never committed to the
+//! kernel; carried as `probes/census-fold/topo-hook.patch`.
+//!
+//! When `CENSUS_FOLD_DIR` is set, every body that passes tier 3 through
+//! `validate_geometric_certificate`, and every body handed to the tier-3′
+//! pass with EMPTY contacts, is re-gated: tier 3, the empty-contact
+//! tier 3′ and the census alone, each timed (median of `CENSUS_FOLD_REPS`,
+//! default 3), and one JSON line is appended to
+//! `$CENSUS_FOLD_DIR/<pid>.jsonl`.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashSet;
+use std::io::Write as _;
+use std::time::Instant;
+
+use geom_core::Tol;
+
+use crate::Body;
+use crate::boolean::ContactRecords;
+
+thread_local! {
+    static BUSY: Cell<bool> = const { Cell::new(false) };
+    static ORIGIN: RefCell<String> = const { RefCell::new(String::new()) };
+    static SEEN: RefCell<HashSet<u64>> = RefCell::new(HashSet::new());
+}
+
+/// A label for the bodies gated after this call on this thread.
+pub fn set_origin(s: &str) {
+    ORIGIN.with(|o| *o.borrow_mut() = s.to_string());
+}
+
+fn enabled() -> Option<String> {
+    std::env::var("CENSUS_FOLD_DIR").ok()
+}
+
+fn esc(s: &str) -> String {
+    s.replace('\\', "\\\\")
+        .replace('"', "\\\"")
+        .replace('\n', " ")
+}
+
+fn variant(dbg: &str) -> String {
+    dbg.split(|c: char| c == ' ' || c == '{' || c == '(')
+        .next()
+        .unwrap_or("")
+        .to_string()
+}
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+fn origin() -> String {
+    let set = ORIGIN.with(|o| o.borrow().clone());
+    if !set.is_empty() {
+        return set;
+    }
+    // nextest runs each test as `<bin> --exact <name> ...`.
+    let args: Vec<String> = std::env::args().collect();
+    let bin = args
+        .first()
+        .map(|a| a.rsplit('/').next().unwrap_or(a).to_string())
+        .unwrap_or_default();
+    let name = args
+        .iter()
+        .skip(1)
+        .find(|a| !a.starts_with("--"))
+        .cloned()
+        .unwrap_or_else(|| {
+            std::thread::current()
+                .name()
+                .unwrap_or("?")
+                .to_string()
+        });
+    format!("{bin}::{name}")
+}
+
+fn fingerprint<T: geom_core::Bounds>(body: &Body<T>) -> (u64, String) {
+    use std::hash::{Hash, Hasher};
+    let c = crate::readback::euler_counts(body);
+    let mut pts: Vec<[i64; 3]> = body
+        .points
+        .values()
+        .map(|p| {
+            [
+                (p.x.lo() * 1e6).round() as i64,
+                (p.y.lo() * 1e6).round() as i64,
+                (p.z.lo() * 1e6).round() as i64,
+            ]
+        })
+        .collect();
+    pts.sort_unstable();
+    let mut kinds: Vec<String> = body
+        .surfaces
+        .values()
+        .map(|s| format!("{:?}", s.kind()))
+        .collect();
+    kinds.sort();
+    kinds.dedup();
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (c.v, c.e, c.f, c.r, c.s).hash(&mut h);
+    pts.hash(&mut h);
+    kinds.hash(&mut h);
+    let shape = format!(
+        "\"v\":{},\"e\":{},\"f\":{},\"r\":{},\"s\":{},\"solids\":{},\"kinds\":\"{}\"",
+        c.v,
+        c.e,
+        c.f,
+        c.r,
+        c.s,
+        body.solids.len(),
+        kinds.join("+")
+    );
+    (h.finish(), shape)
+}
+
+/// Called after a body is known to pass tier 3 (`entry` names the door).
+pub(crate) fn observe<
+    T: geom_core::Decide + geom_core::CertifiedBounds + crate::props::AtRestPolicy,
+>(
+    body: &Body<T>,
+    tol: Tol,
+    entry: &str,
+) {
+    let Some(dir) = enabled() else { return };
+    if BUSY.with(Cell::get) {
+        return;
+    }
+    let (fp, shape) = fingerprint(body);
+    if !SEEN.with(|s| s.borrow_mut().insert(fp)) {
+        return;
+    }
+    BUSY.with(|b| b.set(true));
+    let reps: usize = std::env::var("CENSUS_FOLD_REPS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(3);
+    let empty = ContactRecords::default();
+
+    let mut t3 = Vec::new();
+    let mut t3_ok = true;
+    for _ in 0..reps {
+        let t = Instant::now();
+        let r = crate::validate_geometric(body, tol);
+        t3.push(t.elapsed().as_secs_f64());
+        t3_ok &= r.is_ok();
+    }
+    let mut tp = Vec::new();
+    let mut p_err: Vec<String> = Vec::new();
+    for _ in 0..reps {
+        let t = Instant::now();
+        let r = crate::validate_pseudomanifold(body, &empty, tol);
+        tp.push(t.elapsed().as_secs_f64());
+        p_err = r.err().unwrap_or_default().iter().map(|e| format!("{e:?}")).collect();
+    }
+    // The census alone, as `AtRestBody::validate_pseudomanifold` pays it.
+    let mut tc = Vec::new();
+    let mut c_err: Vec<String> = Vec::new();
+    if let Ok(band) = geom_core::Band::linear(tol) {
+        for _ in 0..reps {
+            let t = Instant::now();
+            let errs = crate::census::census_and_certify(
+                body,
+                &empty,
+                band,
+                tol,
+                Some(crate::chart_region::RegionLane::certified()),
+            );
+            tc.push(t.elapsed().as_secs_f64());
+            c_err = errs.iter().map(|e| format!("{e:?}")).collect();
+        }
+    }
+    BUSY.with(|b| b.set(false));
+
+    let mut variants: Vec<String> = p_err.iter().map(|e| variant(e)).collect();
+    variants.sort();
+    let mut counts: Vec<String> = Vec::new();
+    let mut i = 0;
+    while i < variants.len() {
+        let j = variants[i..].iter().take_while(|v| **v == variants[i]).count();
+        counts.push(format!("\"{}\":{}", variants[i], j));
+        i += j;
+    }
+    let shown: Vec<String> = p_err
+        .iter()
+        .take(6)
+        .map(|e| format!("\"{}\"", esc(&e.chars().take(900).collect::<String>())))
+        .collect();
+    let line = format!(
+        "{{\"origin\":\"{}\",\"entry\":\"{}\",\"scalar\":\"{}\",\"eps\":{:e},\"fp\":\"{:016x}\",{},\"t3_ok\":{},\"p_ok\":{},\"c_ok\":{},\"t3_s\":{:e},\"p_s\":{:e},\"c_s\":{:e},\"variants\":{{{}}},\"n_err\":{},\"n_cerr\":{},\"errs\":[{}]}}\n",
+        esc(&origin()),
+        entry,
+        T::NAME,
+        tol.eps(),
+        fp,
+        shape,
+        t3_ok,
+        p_err.is_empty(),
+        c_err.is_empty(),
+        median(t3),
+        median(tp),
+        if tc.is_empty() { f64::NAN } else { median(tc) },
+        counts.join(","),
+        p_err.len(),
+        c_err.len(),
+        shown.join(",")
+    );
+    let path = format!("{dir}/{}.jsonl", std::process::id());
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    {
+        let _ = f.write_all(line.as_bytes());
+    }
+}
+
+/// Logs the fingerprint of a body gated WITH non-empty contacts, so the
+/// reduction can tell a contact-carrying body from a contact-free one.
+pub(crate) fn declared<T: geom_core::Bounds>(body: &Body<T>, contacts: &ContactRecords) {
+    let Some(dir) = enabled() else { return };
+    let (fp, _) = fingerprint(body);
+    let n = contacts.vv.len()
+        + contacts.a_on_b.len()
+        + contacts.b_on_a.len()
+        + contacts.curves.len()
+        + contacts.patches.len();
+    let line = format!(
+        "{{\"declared\":\"{fp:016x}\",\"n\":{n},\"origin\":\"{}\"}}\n",
+        esc(&origin())
+    );
+    let path = format!("{dir}/{}.declared.jsonl", std::process::id());
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    {
+        let _ = f.write_all(line.as_bytes());
+    }
+}
