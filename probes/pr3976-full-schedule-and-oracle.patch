diff --git a/demos/tour/src/lily.rs b/demos/tour/src/lily.rs
index 9219badd9..0fd7c710d 100644
--- a/demos/tour/src/lily.rs
+++ b/demos/tour/src/lily.rs
@@ -2682,6 +2682,34 @@ mod review_probes {
         plant::<f64>(Tol::witness())
     }
 
+    /// Reviewer probe for PR 3976: the certified reading of each swept
+    /// leaf at the run's ε, against a mesh-Richardson oracle and Pappus.
+    #[test]
+    fn probe3976_leaf_volumes() {
+        use pncad::mesh::validate::signed_volume;
+        let ps = pieces();
+        for (name, leaf) in [("lily_leaf_b", LEAF_B), ("lily_leaf_c", LEAF_C)] {
+            let pappus = leaf.section.area()
+                * leaf.curl.abs().mul_add(leaf.section.centroid_rise(), leaf.len);
+            let b = body(&ps, name);
+            let r = pncad::topo::validate_geometric_certificate(b, Tol::witness())
+                .expect("tier 3")
+                .measure();
+            match &r {
+                Ok(p) => eprintln!("PROBE3976 {name}: NUMBER {:e} pad {:e} -> [{:e}, {:e}]", p.volume, p.volume_pad, p.volume - p.volume_pad, p.volume + p.volume_pad),
+                Err(e) => eprintln!("PROBE3976 {name}: REFUSED {e} / {e:?}"),
+            }
+            let mut prev: Option<(f64, f64)> = None;
+            for delta in [2e-3, 1e-3, 5e-4, 2.5e-4, 1.25e-4] {
+                let m = pncad::mesh::tessellate(b, delta, Tol::witness()).expect("tessellate");
+                let v = signed_volume(&m);
+                let rich = prev.map(|(_, pv)| 2.0 * v - pv);
+                eprintln!("PROBE3976 {name}: mesh delta={delta:e} V={v:.9e} richardson(lin)={rich:?} pappus={pappus:.9e}");
+                prev = Some((delta, v));
+            }
+        }
+    }
+
     fn body<'a>(ps: &'a [Piece<f64>], name: &str) -> &'a Body<f64> {
         &ps.iter().find(|p| p.name == name).expect("piece").body
     }
