+    // REVIEWER MUTANT (reach-dual3977-r1): R1_MUT=zero|double.
+    let v = {
+        use geom_core::Bounds as _;
+        let (lo, hi) = (v.lo(), v.hi());
+        let mid = 0.5 * (lo + hi);
+        match std::env::var("R1_MUT").as_deref() {
+            Ok("zero") => Interval::from_bounds(mid, mid),
+            Ok("double") => Interval::from_bounds(mid - (hi - lo), mid + (hi - lo)),
+            Ok("huge") => Interval::from_bounds(-1e30, 1e30),
+            _ => v,
+        }
+    };
+    Ok((v, area))
