+thread_local! {
+    /// Instrumentation: faces a one-loop crossing split.
+    pub(crate) static PX_FACES: std::cell::RefCell<Vec<FaceKey>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Instrumentation: splices each split face's ring that meets its outer
+/// loop at a vertex back into the outer loop.
+pub(super) fn px_mfkrh<T: Decide + crate::props::AtRestPolicy>(body: &mut Body<T>, tol: Tol) {
+    let faces = PX_FACES.with(|c| std::mem::take(&mut *c.borrow_mut()));
+    for f in faces {
+        let Some(fd) = body.get_face(f) else { continue };
+        let (surface, sense) = (fd.surface, fd.sense);
+        for r in fd.rings.clone() {
+            match body.mfkrh_minting(r, crate::euler::FaceSurface::Shared { key: surface, sense }, tol) {
+                Ok(c) => eprintln!("PX mfkrh {r:?} -> {:?}", c.face),
+                Err(e) => eprintln!("PX mfkrh {r:?} failed {e:?}"),
+            }
+        }
+    }
+}
+
+pub(super) fn px_splice<T: Decide>(body: &mut Body<T>) {
+    let faces = PX_FACES.with(|c| std::mem::take(&mut *c.borrow_mut()));
+    for f in faces {
+        loop {
+            let Some(fd) = body.get_face(f) else { break };
+            let outer = fd.outer;
+            let rings = fd.rings.clone();
+            let cyc = |body: &Body<T>, l: LoopKey| match body.get_loop(l).map(|l| l.boundary) {
+                Some(LoopBoundary::Cycle { first }) => body.loop_cycle(first).unwrap_or_default(),
+                _ => Vec::new(),
+            };
+            let oc = cyc(body, outer);
+            let mut done = false;
+            'r: for r in rings {
+                for &h2 in &cyc(body, r) {
+                    let v = body.get_half_edge(h2).unwrap().start;
+                    if let Some(&h1) = oc.iter().find(|&&h| body.get_half_edge(h).unwrap().start == v) {
+                        let p1 = body.get_half_edge(h1).unwrap().prev;
+                        let p2 = body.get_half_edge(h2).unwrap().prev;
+                        for h in cyc(body, r) {
+                            body.half_edges.get_mut(h).unwrap().parent_loop = outer;
+                        }
+                        body.half_edges.get_mut(p1).unwrap().next = h2;
+                        body.half_edges.get_mut(h2).unwrap().prev = p1;
+                        body.half_edges.get_mut(p2).unwrap().next = h1;
+                        body.half_edges.get_mut(h1).unwrap().prev = p2;
+                        body.faces.get_mut(f).unwrap().rings.retain(|&x| x != r);
+                        body.loops.remove(r);
+                        eprintln!("PX spliced ring {r:?} into {outer:?} of {f:?}");
+                        done = true;
+                        break 'r;
+                    }
+                }
+            }
+            if !done {
+                break;
+            }
+        }
+    }
+}
