+/// R2 probe: the pinch battery with each body's point finding.
+#[test]
+#[ignore = "r2 probe"]
+fn r2_pinch_findings() {
+    for i in 0..12 {
+        for j in 0..7 {
+            for k in 0..6 {
+                let psi = f64::from(k) * 1.05 + 0.1;
+                let m = direction(i, j);
+                let (notch, pinch) = pinch_pieces(m, psi);
+                for (tag, r, want) in pinch_runs(m, psi) {
+                    let finding = r.as_ref().ok().and_then(BooleanResult::body).map(|bb| {
+                        pierce_point_finding(&bb.body, notch343().v, tag_cones(&tag, "ab", (&notch, &pinch)))
+                    });
+                    println!("i={i} j={j} k={k} {tag}: {} {finding:?}", outcome(r, want, tol()));
+                }
+            }
+        }
+    }
+}
