crates/topo/src/replace_face.rs gaps_apart 1 pin a_pair_past_eps_answers_past_a_pair_in_band
crates/topo/src/ring_path.rs path_parity 1 pin a_pair_that_says_nothing_answers_past_a_pair_in_band
crates/topo/src/shell.rs band_seam 1 row t4-ports-unpinned-for-a-kept-reading-ahead-of-an-answer
crates/topo/src/shell.rs walls_cross 1 pin a_piece_crossing_answers_past_a_piece_in_band
crates/topo/src/shell.rs wraps_its_period 1 row t4-ports-unpinned-for-a-kept-reading-ahead-of-an-answer
crates/topo/src/side_reader.rs cast_aims 1 row t4-ports-unpinned-for-a-kept-reading-ahead-of-an-answer
crates/topo/src/splitting/finish.rs shell_side 1 pin an_in_band_edge_refuses_typed_only_where_no_edge_decides
# contact: the ends' ladder, the second end at the point past the first in band.
crates/topo/src/splitting/pieced_arc.rs contact 1 pin an_end_in_band_blocks_the_walk_but_not_the_other_end
crates/topo/src/stands.rs insides_at 1 row t4-ports-unpinned-for-a-kept-reading-ahead-of-an-answer
# ladder, the witness ladder: sweep's integration row reads it through
# the production Boolean with a corner in band ahead of an answering one.
crates/topo/src/stands.rs ladder 1 pin a_box_edge_resting_on_a_rim_answers_past_its_in_band_corner
# The entry points that take no `Answering` (`climb_agreeing`,
# `climb_differing`): every answer supersedes the kept rungs, so each call
# is a site. Pins found by the mutant run with only those two mutated.
crates/topo/src/boolean/rim_wedge.rs at 1 pin a_stretch_ridden_both_ways_reads_mixed
crates/topo/src/boolean/vtxfac.rs partner_side 1 pin a_partners_side_of_a_face_is_read_off_its_bounds
# read_paths: the agreeing ladder over the outer references, with a
