# path :: line — the lines of a covered crate's sentence-writing bodies
# that still format with Debug, an exponent or a precision, each a NAME
# and never a scalar. A line is pinned as it is written (whitespace
# folded), so editing one, or swapping what it prints, fires the gate.
#
# crates/profile/src/path/program.rs: `Refused`'s sentence and `Takes`'s
# list name verbs, tip states, arc-spec modes and their targets by their
# Debug identifiers, "in the transition table's identifiers". They are
# the refusal of a step program no authoring surface produces (a corrupt
# or hand-edited file); see
# work/profile/a-lattice-refusal-names-its-verb-and-tip-state-by-debug-identifier.md.
crates/profile/src/path/program.rs :: "the program ends at tip state {state:?} without closing the loop"
crates/profile/src/path/program.rs :: "the {verb:?} verb is not a legal continuation of tip state {state:?}"
crates/profile/src/path/program.rs :: .map(|target| format!("{target:?}"))
crates/profile/src/path/program.rs :: format!("{mode:?}")
crates/profile/src/path/program.rs :: format!("{mode:?}({})", targets.join("/"))
crates/profile/src/path/program.rs :: list(f, takes.map(|verb| format!("{verb:?}")))
crates/profile/src/path/program.rs :: write!(f, "write the {verb:?} step's arc spec as ")?;
