+#[test]
+fn review_probe_stated_row_on_main() {
+    let d = 0.05;
+    let (mut body, face) = box_with_approx_cap(d, MINT_TARGET);
+    let same = approx_face_surface(&body, face);
+    body.set_face_surface_unvouched_for_tests(
+        face,
+        FaceSurface::New { surface: Surface::Approx(same), sense: true },
+    )
+    .unwrap();
+    let band = geom_core::Band::linear(Tol::witness()).unwrap();
+    let chart = body.get_surface(body.get_face(face).unwrap().surface).unwrap().clone();
+    let rims: Vec<_> = body.half_edges().map(|(k, _)| k)
+        .filter(|&k| body.face_of_half_edge(k) == Some(face)).collect();
+    for h in rims {
+        let mut fresh = body.clone();
+        fresh.detach_pcurve(h);
+        let image = topo::pcurve_of(&fresh, h, band);
+        eprintln!("PROBE {h:?} derived: {image:?}");
+        let Ok(image) = image else { continue };
+        let curve = fresh.get_curve_geom(fresh.get_edge(fresh.get_half_edge(h).unwrap().edge).unwrap().curve)
+            .and_then(topo::CurveGeom::certified).unwrap();
+        let (t0, t1) = curve.params();
+        let r = geom_brep::PcurveCache::certify(image, t0, t1, curve.carrier(), &chart, band);
+        eprintln!("PROBE {h:?} certify: {:?}", r.as_ref().err());
+    }
+    let mut m = body.clone();
+    eprintln!("PROBE mint: {:?}", topo::mint_pcurves(&mut m, Tol::witness()));
+    panic!("probe");
+}
