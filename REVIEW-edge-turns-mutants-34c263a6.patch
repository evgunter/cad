+/// REVIEW-ONLY mutant switch (never committed): `REVIEW_MUT`, applied
+/// only at the scalar whose type name contains `REVIEW_MUT_SCALAR`.
+fn review_mutant_at<T>() -> u32 {
+    if let Ok(only) = std::env::var("REVIEW_MUT_SCALAR") {
+        if !core::any::type_name::<T>().contains(&only) {
+            return 0;
+        }
+    }
+    std::env::var("REVIEW_MUT")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(0)
+}
+
+/// REVIEW-ONLY: a carried turn at `site` (0 cylinder, 1 torus, 2 cone)
+/// under mutant `kind·10 + site`: 1 carried→exact, 2 arms reversed,
+/// 3 lever zero, 4 origin and centre swapped, 5 the miss read back
+/// about the axis; 100 is 5 at the cylinder and torus.
+fn review_carried<T: Real>(
+    site: u32,
+    axis: Vec3<T>,
+    origin: Point3<T>,
+    centre: Point3<T>,
+    own: T,
+    (a, b): (Point3<T>, Point3<T>),
+    lever: T,
+) -> EdgeTurn<T> {
+    let good = EdgeTurn::carried(axis, origin, centre, own, (a, b), lever);
+    let m = review_mutant_at::<T>();
+    let m = if m == 100 && site < 2 { 50 + site } else { m };
+    if m % 10 != site {
+        return good;
+    }
+    match m / 10 {
+        1 => EdgeTurn::exact(good.sweep, lever),
+        2 => EdgeTurn {
+            sweep: good.sweep,
+            ..EdgeTurn::new(own, turn_arms(axis, b - centre, a - centre), lever)
+        },
+        3 => EdgeTurn { lever: T::zero(), ..good },
+        4 => EdgeTurn::carried(axis, centre, origin, own, (a, b), lever),
+        5 => EdgeTurn::new(good.sweep, turn_arms(axis, a - origin, b - origin), lever),
+        _ => good,
+    }
+}
