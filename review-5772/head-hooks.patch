+/// Review-only capture (not for merge).
+#[allow(missing_docs, clippy::all)]
+pub(crate) fn review_line(kind: &str, payload: &str) {
+    use std::io::Write;
+    let Some(dir) = std::env::var_os("UNION_CAPTURE_DIR") else {
+        return;
+    };
+    let test = std::env::args()
+        .skip(1)
+        .find(|a| !a.starts_with('-'))
+        .unwrap_or_default();
+    let path = std::path::PathBuf::from(dir).join(format!("{}.aux.txt", std::process::id()));
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{test}\t{kind}\t{payload}");
+    }
+}
+#[allow(missing_docs, clippy::all)]
+pub(crate) fn review_hash(s: &str) -> String {
+    use std::hash::{Hash, Hasher};
+    let h = |s: &str| {
+        let mut x = std::collections::hash_map::DefaultHasher::new();
+        s.hash(&mut x);
+        x.finish()
+    };
+    let key = "ZeroWord(";
+    let mut out = String::with_capacity(s.len());
+    let mut rest = s;
+    while let Some(i) = rest.find(key) {
+        out.push_str(&rest[..i + key.len()]);
+        rest = &rest[i + key.len()..];
+        let j = rest.find(|c: char| !c.is_ascii_digit()).unwrap_or(rest.len());
+        out.push('_');
+        rest = &rest[j..];
+    }
+    out.push_str(rest);
+    format!("raw={:016x} masked={:016x} n={}", h(s), h(&out), s.len())
+}
