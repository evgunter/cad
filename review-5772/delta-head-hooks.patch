+/// Review-only capture hook (not for merge).
+mod review_capture {
+    use super::{BooleanOp, OpResult, RecipeNodeId};
+    use geom_core::Decide;
+    use std::hash::{Hash, Hasher};
+    use std::io::Write;
+    fn h(s: &str) -> u64 {
+        let mut x = std::collections::hash_map::DefaultHasher::new();
+        s.hash(&mut x);
+        x.finish()
+    }
+    fn mask(s: &str) -> String {
+        let key = "ZeroWord(";
+        let mut out = String::with_capacity(s.len());
+        let mut rest = s;
+        while let Some(i) = rest.find(key) {
+            out.push_str(&rest[..i + key.len()]);
+            rest = &rest[i + key.len()..];
+            let j = rest.find(|c: char| !c.is_ascii_digit()).unwrap_or(rest.len());
+            out.push('_');
+            rest = &rest[j..];
+        }
+        out.push_str(rest);
+        out
+    }
+    pub(super) fn fault(var: &str, k: usize) -> bool {
+        std::env::var(var).ok().and_then(|v| v.parse::<usize>().ok()) == Some(k)
+    }
+    pub(super) fn capture<T: Decide>(op: BooleanOp, id: RecipeNodeId, out: &OpResult<T>) {
+        let Some(dir) = std::env::var_os("UNION_CAPTURE_DIR") else {
+            return;
+        };
+        let dir = std::path::PathBuf::from(dir);
+        let line = match out {
+            Ok(o) => {
+                let rows = format!("{:?}", o.coincidences);
+                let rh = h(&rows);
+                let blobs = dir.join("rows");
+                let _ = std::fs::create_dir_all(&blobs);
+                let bp = blobs.join(format!("{rh:016x}.txt"));
+                if !bp.exists() {
+                    let _ = std::fs::write(&bp, &rows);
+                }
+                format!(
+                    "ok body={:016x} names={:016x} rows={:016x} rowsm={:016x} rec={:016x} cited={:016x} parts={} carried={:016x} motion={}",
+                    h(&format!("{:?}", o.payload)),
+                    h(&format!("{:?}", o.outputs)),
+                    rh,
+                    h(&mask(&rows)),
+                    h(&format!("{:?}", o.contacts)),
+                    h(&format!("{:?}", o.cited_inputs)),
+                    o.parts,
+                    h(&format!("{:?}", o.carried)),
+                    o.motion.is_some(),
+                )
+            }
+            Err(e) => {
+                let d = format!("{e:?}");
+                let mut short: String = d.chars().take(300).collect();
+                short = short.replace(['\n', '\t'], " ");
+                format!("err {:016x} {}", h(&d), short)
+            }
+        };
+        let test = std::env::args()
+            .skip(1)
+            .find(|a| !a.starts_with('-'))
+            .unwrap_or_default();
+        let path = dir.join(format!("{}.txt", std::process::id()));
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(f, "{test}\t{op:?}\t{id:?}\t{line}");
+        }
+    }
+}
