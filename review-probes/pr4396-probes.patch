+        0.5,
+    );
+    let serp = strip(
+        &[(-2.5, -2.5), (-2.5, 2.5), (-1.5, 2.5), (-1.5, -2.5), (-0.5, -2.5), (-0.5, 2.5), (0.5, 2.5), (0.5, -2.5), (1.5, -2.5), (1.5, 2.5), (2.5, 2.5), (2.5, -2.5)],
+        0.4,
+    );
+    let plus = crate::common::differential::ccw(vec![
+        (-0.4, -2.5), (0.4, -2.5), (0.4, -0.4), (2.5, -0.4), (2.5, 0.4), (0.4, 0.4),
+        (0.4, 2.5), (-0.4, 2.5), (-0.4, 0.4), (-2.5, 0.4), (-2.5, -0.4), (-0.4, -0.4),
+    ]);
+    let zig = strip(&[(-2.5, -2.0), (-1.5, 2.0), (-0.5, -2.0), (0.5, 2.0), (1.5, -2.0), (2.5, 2.0)], 0.35);
+    let block = finished(
+        "block",
+        topo::test_support::prism_z(&[(-4.0, -4.0), (4.0, -4.0), (4.0, 4.0), (-4.0, 4.0)], -2.0, 0.0, tol).body,
+        tol,
+    );
+    for (name, prof) in [("spiral", &spiral), ("serp", &serp), ("plus", &plus), ("zig", &zig)] {
+        let area = crate::common::differential::area(prof).abs();
+        for (depth, z0) in [("blind", -0.7), ("through", -3.0)] {
+            for deg in [0.0f64, 13.0, 45.0, 71.0] {
+                let raw = topo::test_support::prism_z(prof, z0, 1.0, tol).body;
+                let b = finished("b", crate::common::germ_pair::spin(&raw, Vec3::unit_z(), deg.to_radians()), tol);
+                let vb = area * (1.0 - z0);
+                let vab = area * (0.0 - z0.max(-2.0));
+                for (op, r, want) in every_op_both_orders(&block, &b, (128.0, vb, vab), tol) {
+                    let line = match &r {
+                        Err(e) => format!("{e:?}").chars().take(160).collect(),
+                        Ok(_) => outcome(r, want, tol),
+                    };
+                    eprintln!("POSE {name} {depth} {deg} {op}: {line}");
+                }
+            }
+        }
+    }
