+/// REVIEW PROBE: log each run's outcome per k, without asserting.
+#[test]
+fn review_probe_steep_ellipse_log() {
+    let tol = Tol::witness();
+    let g = GAP_BANDS * tol.eps();
+    for k in [10.0, 60.0] {
+        let (a, b) = (cylinder(k), block(k, g));
+        let va = PI * 2.0 * half_length(k);
+        let vb = (4.0 * (k + 2.0) - (g + 1.0) * (NOTCH_TOP - FLOOR)) * -FLOOR;
+        for (op, r, want) in every_op_both_orders(&a, &b, (va, vb, shared(k, g)), tol) {
+            let s = match &r {
+                Err(e) => format!("ERR filed={} {:?}", stops_where_filed(k, e), e).chars().take(260).collect::<String>(),
+                Ok(_) => outcome(r, want, tol),
+            };
+            eprintln!("PROBE k={k} {op}: {s}");
+        }
+    }
+}
