+/// REVIEW PROBE (claim 4): a strip of width `w` along an orthogonal or
+/// oblique polyline, as one simple polygon (corner offsets by the
+/// bisector, which is exact at right angles).
+fn strip(path: &[(f64, f64)], w: f64) -> Vec<(f64, f64)> {
+    let n = path.len();
+    let nrm = |a: (f64, f64), b: (f64, f64)| {
+        let (dx, dy) = (b.0 - a.0, b.1 - a.1);
+        let l = dx.hypot(dy);
+        (-dy / l, dx / l)
+    };
+    let mut left = Vec::new();
+    let mut right = Vec::new();
+    for i in 0..n {
+        let (nx, ny) = if i == 0 {
+            nrm(path[0], path[1])
+        } else if i == n - 1 {
+            nrm(path[n - 2], path[n - 1])
+        } else {
+            let (a, b) = (nrm(path[i - 1], path[i]), nrm(path[i], path[i + 1]));
+            let (sx, sy) = (a.0 + b.0, a.1 + b.1);
+            let d = sx * a.0 + sy * a.1;
+            (sx / d, sy / d)
+        };
+        left.push((path[i].0 + nx * w / 2.0, path[i].1 + ny * w / 2.0));
+        right.push((path[i].0 - nx * w / 2.0, path[i].1 - ny * w / 2.0));
+    }
+    right.reverse();
+    left.extend(right);
+    crate::common::differential::ccw(left)
+}
