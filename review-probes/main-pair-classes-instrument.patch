+/// REVIEW INSTRUMENT (PR 4358): what the PR head's `pair_classes` would
+/// do on these inputs: `lone`, `refuse-unread`, `refuse-inside`, `err`,
+/// `fallback` or `layered`.
+fn instr_head_tag<T: Decide>(pairs: &[PairRead<T>], band: Band) -> &'static str {
+    if let [_] = pairs {
+        return "lone";
+    }
+    if pairs.iter().any(|p| p.read.is_none()) {
+        return "refuse-unread";
+    }
+    let mut base = None;
+    for i in 0..pairs.len() {
+        let mut outermost = true;
+        for j in (0..pairs.len()).filter(|&j| j != i) {
+            match super::sectors::wedge_classes(&pairs[i].sectors, &pairs[j].sectors, band) {
+                Err(_) => return "err",
+                Ok(None) => return "refuse-inside",
+                Ok(Some(r)) => {
+                    if !r.rows.is_empty() && r.rows.iter().all(|&(_, c)| held(c, r.met)) {
+                        outermost = false;
+                    }
+                }
+            }
+        }
+        if outermost {
+            let read = pairs[i].read.as_ref().unwrap();
+            let here = if read.met { SideCode::Out } else { SideCode::In };
+            if base.is_some_and(|b| b != here) {
+                return "fallback";
+            }
+            base = Some(here);
+        }
+    }
+    let Some(base) = base else { return "fallback" };
+    let first = pairs[0].read.as_ref().unwrap();
+    if first.rows.iter().all(|&(he, _)| layered(base, he, pairs.iter()).is_some()) {
+        "layered"
+    } else {
+        "fallback"
+    }
+}
