+    /// Review R2 probe: two unit cubes `g = 15ε` apart (their facing
+    /// faces definite at `Kε`), a ray crossing the gap's mouth into the
+    /// second cube near its top edge: what the edge-meeting count reads.
+    #[test]
+    fn review_r2_two_edges_of_faces_definite_apart() {
+        let tol = Tol::witness();
+        let band = Band::linear(tol).unwrap();
+        for m in [12.0, 15.0, 19.0, 25.0, 40.0] {
+            let g = m * tol.eps();
+            let mut body = quad_prism(&[(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)], 1.0, tol);
+            let other = quad_prism(
+                &[(1.0 + g, 0.0), (2.0 + g, 0.0), (2.0 + g, 1.0), (1.0 + g, 1.0)],
+                1.0,
+                tol,
+            );
+            crate::instance::graft_disjoint(&mut body, &other).unwrap();
+            let sel = SolidFaces::select(&body, body.faces().map(|(k, _)| k).collect()).unwrap();
+            let geos: Vec<_> = sel
+                .faces()
+                .iter()
+                .map(|&face| (face, face_geo(&body, face, &sel.charts, band).unwrap()))
+                .collect();
+            let d = Vec3::new(0.5, 0.3, -1.0).normalize();
+            // Through `(1 + g/2, 0.5, 1)`, from above.
+            let q = Point3::new(1.0 + 0.5 * g, 0.5, 1.0) - d * 2.0;
+            let reach = selection_reach(&body, sel.faces(), q).unwrap();
+            let got = cast_ray(&body, &geos, q, d, reach, band);
+            eprintln!("R2GAP m={m} eps={:e}: {:?}", tol.eps(), got.map_err(|e| format!("{e:?}").chars().take(160).collect::<String>()));
+        }
+    }
