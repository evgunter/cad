# ORACLE: FreeCAD 1.1.2 (Libs 1.1.2R20260723), `Part.Shape().read(path)`,
# run 2026-08-04 on the UNMODIFIED upstream file (before the provenance
# comment was added). Volume is FreeCAD's `Shape.Volume`, in mm3. The wild
# has no closed forms: this oracle is the ONLY independent volume these
# fixtures have, and it is an independent IMPLEMENTATION, not a proof.
ORACLE_SOLIDS=1
ORACLE_SHELLS=1
ORACLE_FACES=158
ORACLE_EDGES=495
ORACLE_VERTICES=342
ORACLE_VOLUME_MM3=136445.10482466163

# CENSUS DIVERGENCE. Open CASCADE splits a periodic carrier at its seam on
# import and adds the seam edge and its vertices; the kernel keeps the
# file's own boundary graph (D7: adopt, do not heal). Where KERNEL_* lines
# appear they are what a faithful import must produce and the ORACLE_*
# lines are what OCC reports after its own normalization.
KERNEL_EDGES=454
KERNEL_VERTICES=300
