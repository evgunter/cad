# FreeCAD/OCC import expectations for ball.step (M5 PR 13 curved
# corpus). Counts are what OCC reports after import; the volume is the
# EXACT ANALYTIC value in FreeCAD's internal mm^3, not a readback --
# unit ball: 4pi/3 m^3
#
# Kernel census is 2 faces / 2 edges / 2 vertices. OCC reports 6 EDGES:
# on import it ADDS the two degenerate pole edges each sphere face needs
# in its own face model (2 real seam meridians + 4 degenerate). Faces,
# vertices and the volume are unchanged -- OCC normalising a pole chart,
# not a geometry difference.
#
# KERNEL_* pin the NATIVE body's census and certified volume, full
# precision (the literal is the export writer's round-tripping float
# printer's output; crates/step-export/tests/kernel_sidecars.rs asserts
# these lines against the live kernel). scripts/check_step.sh consumes
# EXPECT_* (what FreeCAD/OCC reports after import) and ignores KERNEL_*.
KERNEL_SOLIDS=1
KERNEL_SHELLS=1
KERNEL_FACES=2
KERNEL_EDGES=2
KERNEL_VERTICES=2
KERNEL_VOLUME_MM3=4188790204.7863903
EXPECT_SOLIDS=1
EXPECT_SHELLS=1
EXPECT_FACES=2
EXPECT_EDGES=6
EXPECT_VERTICES=2
EXPECT_VOLUME_MM3=4188790204.7863903
