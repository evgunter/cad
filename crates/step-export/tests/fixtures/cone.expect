# FreeCAD/OCC import expectations for cone.step (M5 PR 13 curved
# corpus). Counts are what OCC reports after import; the volume is the
# EXACT ANALYTIC value in FreeCAD's internal mm^3, not a readback --
# right cone base radius 1 height 1: pi/3 m^3
#
# Kernel census is 2 faces / 2 edges / 2 vertices (the cone's one
# band, whose wrap ruling runs from the apex to the base rim, and ONE
# base disc; a full revolve builds each wall whole); OCC reports 3
# EDGES, adding a degenerate apex edge to the conical face (the same
# pole-chart normalisation it applies to the ball). Faces, vertices and
# the volume are unchanged. These EXPECT_* counts were measured with
# OCC's own reader (the OCP bindings, counting as FreeCAD's Part.read
# does, which reproduced every other fixture's committed counts), not
# in FreeCAD itself; scripts/check_step.sh is what confirms them.
#
# KERNEL_* pin the NATIVE body's census and certified volume, full
# precision (the literal is the export writer's round-tripping float
# printer's output; crates/step-export/tests/kernel_sidecars.rs asserts
# these lines against the live kernel). scripts/check_step.sh consumes
# EXPECT_* (what FreeCAD/OCC reports after import) and ignores KERNEL_*.
KERNEL_SOLIDS=1
KERNEL_SHELLS=1
KERNEL_FACES=2
KERNEL_EDGES=2
KERNEL_VERTICES=2
KERNEL_VOLUME_MM3=1047197551.1965976
KERNEL_VOLUME_PAD_MM3=0.0
EXPECT_SOLIDS=1
EXPECT_SHELLS=1
EXPECT_FACES=2
EXPECT_EDGES=3
EXPECT_VERTICES=2
EXPECT_VOLUME_MM3=1047197551.1965976
