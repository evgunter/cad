# KERNEL_* pin the NATIVE body's census and certified volume, full
# precision (the literal is the export writer's round-tripping float
# printer's output; crates/step-export/tests/kernel_sidecars.rs asserts
# these lines against the live kernel). scripts/check_step.sh consumes
# EXPECT_* (what FreeCAD/OCC reports after import) and ignores KERNEL_*.
#
# The two kissing pieces are two solids natively (a solid is one piece
# of material, and pieces that only touch are distinct), so the native
# census and the export agree: 2 solids / 2 shells.
KERNEL_SOLIDS=2
KERNEL_SHELLS=2
KERNEL_FACES=22
KERNEL_EDGES=48
KERNEL_VERTICES=32
KERNEL_VOLUME_MM3=1750000000.0
KERNEL_VOLUME_PAD_MM3=0.0
EXPECT_SOLIDS=2
EXPECT_SHELLS=2
EXPECT_FACES=22
EXPECT_EDGES=48
EXPECT_VERTICES=32
EXPECT_VOLUME_MM3=1.75e9
