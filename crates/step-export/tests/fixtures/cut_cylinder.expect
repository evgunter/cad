# FreeCAD/OCC import expectations for cut_cylinder.step (M5 PR 13 curved
# corpus). Counts are what OCC reports after import; the volume is the
# EXACT ANALYTIC value in FreeCAD's internal mm^3, not a readback --
# unit cylinder h=2.5 halved by a 0.3 rad tilted plane through the axis midpoint: pi*1.25 m^3
#
# OCC keeps the kernel topology exactly (4/6/4).
#
# KERNEL_* pin the NATIVE body's census and certified volume, full
# precision (the literal is the export writer's round-tripping float
# printer's output; crates/step-export/tests/kernel_sidecars.rs asserts
# these lines against the live kernel). scripts/check_step.sh consumes
# EXPECT_* (what FreeCAD/OCC reports after import) and ignores KERNEL_*.
# Here the certified volume is a QUADRATURE enclosure midpoint (the
# tilted cut makes curved-cut faces), so it differs from the analytic
# EXPECT value inside the enclosure's certified pad.
KERNEL_SOLIDS=1
KERNEL_SHELLS=1
KERNEL_FACES=4
KERNEL_EDGES=6
KERNEL_VERTICES=4
KERNEL_VOLUME_MM3=3926990816.7918763
EXPECT_SOLIDS=1
EXPECT_SHELLS=1
EXPECT_FACES=4
EXPECT_EDGES=6
EXPECT_VERTICES=4
EXPECT_VOLUME_MM3=3926990816.9872413
