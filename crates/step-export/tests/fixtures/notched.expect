# FreeCAD/OCC import expectations for notched.step (M5 PR 13 curved
# corpus). Counts are what OCC reports after import; the volume is the
# EXACT ANALYTIC value in FreeCAD's internal mm^3, not a readback --
# 2x1.5 rectangle, equal convex/concave 45 deg bulges cancelling, extruded 1: exactly 3 m^3
#
# OCC keeps the kernel topology exactly (6/12/8).
#
# KERNEL_* pin the NATIVE body's census and certified volume, full
# precision (the literal is the export writer's round-tripping float
# printer's output; crates/step-export/tests/kernel_sidecars.rs asserts
# these lines against the live kernel). scripts/check_step.sh consumes
# EXPECT_* (what FreeCAD/OCC reports after import) and ignores KERNEL_*.
KERNEL_SOLIDS=1
KERNEL_SHELLS=1
KERNEL_FACES=6
KERNEL_EDGES=12
KERNEL_VERTICES=8
KERNEL_VOLUME_MM3=3000000000.0
EXPECT_SOLIDS=1
EXPECT_SHELLS=1
EXPECT_FACES=6
EXPECT_EDGES=12
EXPECT_VERTICES=8
EXPECT_VOLUME_MM3=3000000000.0
