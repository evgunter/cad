+/// Designer-B probe (not for landing): the complement of the crescent
+/// pose near its tip. `A` is a block with a blind pocket `r = 0.3`
+/// (floor at `z = 0`), `B` a slab `z ∈ [0, 0.5]` with a peg `r = 0.1`
+/// about `(0.2, 0)` hanging below it, tangent inside the pocket's rim
+/// at `(0.3, 0, 0)`. Locally `A ∩ B` is the complement of the boss ∪
+/// holed plate. Prints every op's outcome.
+#[test]
+#[ignore = "designer probe"]
+fn svc_b_dual_crescent_probe() {
+    for form in [true, false] {
+        let cutter = fin("the cutter", extruded(vec![rim(form, 0.0, 0.3, 0.0)], 0.0, 1.5));
+        let block = fin("the block", brick((-1.0, 1.0), (-1.0, 1.0), (-0.5, 1.0), tol()));
+        let pocketed = topo::subtract(&block, &cutter, tol()).unwrap();
+        let a = fin("the pocketed block", pocketed.body().unwrap().body.clone().into_body());
+        let slab = fin("the slab", brick((-1.0, 1.0), (-1.0, 1.0), (0.0, 0.5), tol()));
+        let peg = fin("the peg", extruded(vec![rim(form, 0.2, 0.1, 0.0)], -0.5, 0.75));
+        let pegged = topo::union(&slab, &peg, tol()).unwrap();
+        let b = fin("the pegged slab", pegged.body().unwrap().body.clone().into_body());
+        let va = 6.0 - 0.09 * PI;
+        let vb = 2.0 + 0.005 * PI;
+        let vab = 2.0 - 0.04 * PI;
+        for (op, x, y, want) in [
+            ("A ∪ B", &a, &b, va + vb - vab),
+            ("B ∪ A", &b, &a, va + vb - vab),
+            ("A ∩ B", &a, &b, vab),
+            ("B ∩ A", &b, &a, vab),
+            ("A ∖ B", &a, &b, va - vab),
+            ("B ∖ A", &b, &a, vb - vab),
+        ] {
+            let r = match op {
+                "A ∪ B" | "B ∪ A" => topo::union(x, y, tol()),
+                "A ∩ B" | "B ∩ A" => topo::intersect(x, y, tol()),
+                _ => topo::subtract(x, y, tol()),
+            };
+            let shells = r.as_ref().ok().and_then(|b| b.body()).map(|b| census(&b.body));
+            if let Some(b) = r.as_ref().ok().and_then(|b| b.body()) {
+                if let Err(es) = topo::validate_pseudomanifold(&b.body, &b.contacts, tol()) {
+                    println!("SVC-B-DUAL-T3P {op}: {:?}", es.iter().map(|e| format!("{e:?}").chars().take(160).collect::<String>()).collect::<Vec<_>>());
+                }
+            }
+            let j = judged_within(r, Some(want), tol(), VOLUME_PAD_BUDGET);
+            println!("SVC-B-DUAL form_one={form} {op}: {} census={shells:?}", j.line);
+        }
+    }
+}
