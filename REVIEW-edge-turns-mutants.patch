+/// REVIEW-ONLY mutant switch (never committed): `REVIEW_MUT`, applied
+/// only at the scalar whose type name contains `REVIEW_MUT_SCALAR`.
+fn review_mutant_at<T>() -> u32 {
+    if let Ok(only) = std::env::var("REVIEW_MUT_SCALAR") {
+        if !core::any::type_name::<T>().contains(&only) {
+            return 0;
+        }
+    }
+    std::env::var("REVIEW_MUT")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(0)
+}
