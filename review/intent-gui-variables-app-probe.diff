+    #[test]
+    fn zz_review_probe_open_name_field_renames_a_named_variable_after_accept() {
+        let mut pane = Driven::with(typed_beside("beam", 0.004));
+        pane.quiet();
+        pane.click("name\u{2026}");
+        assert!(pane.app.drafts.name_draft.is_some(), "field open");
+        let beam = pane.app.session.committed_doc().var_named("beam").expect("beam");
+        let out = pane.app.session.perform(SessionOp::SetSlotVariable {
+            node: extrude(),
+            slot: SlotId::Distance,
+            var: beam,
+        });
+        assert!(out.refusal.is_none());
+        pane.quiet();
+        pane.click("Name");
+        let doc = pane.app.session.committed_doc();
+        eprintln!("PROBE beam now named {:?}", doc.var_name(beam));
+        assert_eq!(doc.var_name(beam).map(|n| n.as_str()), Some("beam"), "the named variable was renamed through the slot's stale naming field");
+    }
+
     /// **A driven slot's unit picker is drawn, cannot be opened, and
