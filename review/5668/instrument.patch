 pub(crate) mod raw_door {
     use super::*;
 
+    #[track_caller]
+    #[allow(missing_docs, clippy::all, clippy::pedantic, unreachable_pub)]
+    pub fn rawdoor_probe_log<T: Real>(body: &Body<T>, tol: Tol, door: &str) {
+        let Some(path) = std::env::var_os("RAWDOOR_LOG") else { return };
+        let loc = core::panic::Location::caller();
+        let verdict = if let Some(b) = (body as &dyn core::any::Any).downcast_ref::<Body<f64>>() {
+            match crate::validate_geometric(b, tol) {
+                Ok(()) => "PASS".to_string(),
+                Err(e) => {
+                    let mut v: Vec<String> = e.iter().map(|x| { let s = format!("{x:?}"); s.split(|c| c == ' ' || c == '{' || c == '(').next().unwrap_or("").to_string() }).collect();
+                    v.sort(); v.dedup();
+                    format!("REFUSE {}", v.join(","))
+                }
+            }
+        } else {
+            format!("NONF64 {}", core::any::type_name::<T>())
+        };
+        let eps = std::env::var("CAD_TOLERANCE_EPS").unwrap_or_default();
+        use std::io::Write;
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(f, "{}:{} {} eps={} {}", loc.file(), loc.line(), door, eps, verdict);
+        }
+    }
+
