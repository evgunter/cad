+fn census_log<A: std::fmt::Debug, B: std::fmt::Debug>(arm: &str, scalar: &str, old: &A, new: &B) {
+    use std::io::Write;
+    let Ok(path) = std::env::var("CENSUS_LOG") else { return };
+    let (o, n) = (format!("{old:?}"), format!("{new:?}"));
+    let args: Vec<String> = std::env::args().collect();
+    let who = format!("{} {:?}", args.get(1).cloned().unwrap_or_default(), std::thread::current().name());
+    let tag = if o == n { "SAME" } else { "DIFF" };
+    let mut line = format!("{tag} {arm} {scalar} {who}");
+    if o != n { line.push_str(&format!("
+  old={o}
+  new={n}")); }
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{line}");
+    }
+}
