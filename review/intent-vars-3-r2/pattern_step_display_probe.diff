+
+#[test]
+fn r2_probe_plain_display_of_a_memoized_step_refusal() {
+    let th = VarName::from_static("th");
+    let params = BTreeMap::from([(th.clone(), Dimension::Angle)]);
+    let expr = parse_expr("th", &params).unwrap();
+    let built = driven(5, circular(expr), (&th, f64::to_radians(760.0)));
+    let ev = eval::<f64>(&built.doc);
+    let Some(NodeResult::Failed(e)) = ev.result(built.node) else { panic!() };
+    eprintln!("R2 kind.to_string(): {}", e.kind);
+    eprintln!("R2 spoken(doc):      {}", e.spoken(&built.doc));
+    let renamed = editor_core::apply(
+        &built.doc,
+        &editor_core::DocEdit::RenameVar { var: th.clone().into(), name: Some(VarName::from_static("phi")) },
+        geom_core::Tol::witness(),
+        &editor_core::RefusingReach,
+    ).unwrap().doc;
+    eprintln!("R2 after rename, spoken(renamed): {}", e.spoken(&renamed));
+}
