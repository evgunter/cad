@@ -975,7 +975,85 @@ fn tessellate_impl(
 /// chord chain that both use a chord between two of its points as an
 /// interior edge use it twice each, and no patch sees that alone. It
 /// refuses [`TessellateError::OverusedSide`].
-fn joined(mesh: Mesh, shared_below: u32) -> Result<Mesh, TessellateError> {
+fn joined(mut mesh: Mesh, shared_below: u32) -> Result<Mesh, TessellateError> {
+    // PROBE (designer measurement, not shipped).
+    if let Ok(mode) = std::env::var("JOIN_PROBE") {
+        let polylines: Vec<Vec<u32>> = mesh.boundaries.iter().map(|b| b.points.clone()).collect();
+        let pl: Vec<&[u32]> = polylines.iter().map(Vec::as_slice).collect();
+        let uses = side_uses(
+            &pl,
+            mesh.patches.iter().map(|p| p.triangles.as_slice()),
+            shared_below,
+        );
+        let mut over: Vec<((u32, u32), (usize, usize))> = uses
+            .iter()
+            .filter(|&(_, &(c, n))| n > 2 * c.max(1))
+            .map(|(&s, &v)| (s, v))
+            .collect();
+        over.sort_unstable();
+        let coincident = uses.iter().filter(|&(_, &(c, n))| c >= 2 && n > 2).count();
+        let chorded = over.iter().filter(|(_, (c, _))| *c > 0).count();
+        if !over.is_empty() || coincident > 0 {
+            eprintln!(
+                "JOINPROBE overused {} (on a chord: {}) coincident_chord_sides {}",
+                over.len(),
+                chorded,
+                coincident
+            );
+        }
+        if mode == "cure" {
+            let mut cuts = 0usize;
+            for ((a, b), (chords, _)) in over {
+                let mut kept = chords > 0;
+                for patch in &mut mesh.patches {
+                    let n = patch
+                        .triangles
+                        .iter()
+                        .filter(|&&t| crate::walk::sides(t).contains(&(a, b)))
+                        .count();
+                    if n == 0 {
+                        continue;
+                    }
+                    if chords > 0 {
+                        eprintln!("JOINPROBE chorded side {:?} used {n} by {:?}", (a, b), patch.face);
+                        continue;
+                    }
+                    if !kept {
+                        kept = true;
+                        continue;
+                    }
+                    #[allow(clippy::cast_possible_truncation)]
+                    let m = mesh.positions.len() as u32;
+                    let (pa, pb) = (mesh.positions[a as usize], mesh.positions[b as usize]);
+                    mesh.positions.push(Point3::new(
+                        0.5 * (pa.x + pb.x),
+                        0.5 * (pa.y + pb.y),
+                        0.5 * (pa.z + pb.z),
+                    ));
+                    let mut out = Vec::with_capacity(patch.triangles.len() + 2);
+                    for &t in &patch.triangles {
+                        let at = (0..3).find(|&q| {
+                            let (x, y) = (t[q], t[(q + 1) % 3]);
+                            (x == a && y == b) || (x == b && y == a)
+                        });
+                        match at {
+                            None => out.push(t),
+                            Some(q) => {
+                                let (x, y, z) = (t[q], t[(q + 1) % 3], t[(q + 2) % 3]);
+                                out.push([x, m, z]);
+                                out.push([m, y, z]);
+                            }
+                        }
+                    }
+                    patch.triangles = out;
+                    cuts += 1;
+                }
+            }
+            if cuts > 0 {
+                eprintln!("JOINCUT {cuts}");
+            }
+        }
+    }
     let polylines: Vec<&[u32]> = mesh
