+/// PROBE (designer measurement, not shipped).
+#[test]
+fn zz_probe_join() {
+    for (r, deltas) in [
+        (1.05, &[3.0, 1.0, 0.3, 0.1, 0.05, 0.04, 0.03][..]),
+        (1.3, &[3.0, 0.5, 0.25, 0.1][..]),
+    ] {
+        for sign in [1.0, -1.0] {
+            let body = bored_ball_of(r, sign);
+            let solid = split_and_placed(&body, &[], &[]);
+            let [seam] = rulings(&body)[..] else {
+                panic!("the bore has one seam");
+            };
+            let split = split_and_placed(&body, &[seam], &[0.5]);
+            for (name, b) in [("unsplit", &solid), ("split", &split)] {
+                for &delta in deltas {
+                    eprintln!("CELL r={r} sign={sign} {name} d={delta}");
+                    match mesh::tessellate(b, delta, tol()) {
+                        Ok(m) => {
+                            let cm = mesh::validate::check_mesh(&m);
+                            let geo = geometry_enclosing(b, &solid, &m, delta);
+                            let chords: Vec<usize> =
+                                m.boundaries.iter().map(|x| x.points.len() - 1).collect();
+                            eprintln!(
+                                "RESULT ok tris={} check_mesh={:?} geometry={:?} chords={:?}",
+                                mesh::validate::triangle_count(&m),
+                                cm,
+                                geo,
+                                chords
+                            );
+                        }
+                        Err(e) => {
+                            let s = format!("{e:?}");
+                            eprintln!("RESULT err {}", &s[..s.len().min(160)]);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
