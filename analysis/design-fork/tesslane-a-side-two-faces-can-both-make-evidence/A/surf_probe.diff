+/// PROBE (designer measurement, not shipped): split every overused side
+/// in EVERY patch using it, at the surface foot of the chord midpoint.
+#[allow(clippy::all, clippy::pedantic)]
+fn surf_probe(mesh: &mut Mesh, shared_below: u32, body: &Body<f64>, delta: f64) {
+    if std::env::var("JOIN_PROBE").as_deref() != Ok("surf") {
+        return;
+    }
+    let polylines: Vec<Vec<u32>> = mesh.boundaries.iter().map(|b| b.points.clone()).collect();
+    let pl: Vec<&[u32]> = polylines.iter().map(Vec::as_slice).collect();
+    let uses = side_uses(&pl, mesh.patches.iter().map(|p| p.triangles.as_slice()), shared_below);
+    let mut over: Vec<((u32, u32), (usize, usize))> = uses
+        .iter()
+        .filter(|&(_, &(c, n))| n > 2 * c.max(1))
+        .map(|(&s, &v)| (s, v))
+        .collect();
+    over.sort_unstable();
+    if over.is_empty() {
+        return;
+    }
+    let sub = |a: Point3<f64>, b: Point3<f64>| [a.x - b.x, a.y - b.y, a.z - b.z];
+    let cross = |u: [f64; 3], v: [f64; 3]| [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]];
+    let dot = |u: [f64; 3], v: [f64; 3]| u[0]*v[0]+u[1]*v[1]+u[2]*v[2];
+    let mut stats = (0usize, 0usize, 0usize, 0usize, 0usize, 0f64, 0f64); // cuts, folds, devfail, nofoot, chorded, worst child/δ, worst parent/δ
+    let mut kinds: Vec<String> = Vec::new();
+    for ((a, b), (chords, _)) in over {
+        if chords > 0 { stats.4 += 1; continue; }
+        for pi in 0..mesh.patches.len() {
+            let n = mesh.patches[pi].triangles.iter().filter(|&&t| crate::walk::sides(t).contains(&(a, b))).count();
+            if n == 0 { continue; }
+            let Ok(surface) = face_surface(body, mesh.patches[pi].face) else { continue; };
+            let dev = |x: Point3<f64>| surface.foot(x).map(|f| { let d = sub(x, f); dot(d, d).sqrt() });
+            let (pa, pb) = (mesh.positions[a as usize], mesh.positions[b as usize]);
+            let mid = Point3::new(0.5*(pa.x+pb.x), 0.5*(pa.y+pb.y), 0.5*(pa.z+pb.z));
+            let m_pos = match surface.foot(mid) { Some(f) => f, None => { stats.3 += 1; mid } };
+            let k = format!("{:?}", std::mem::discriminant(surface));
+            let kind = match surface { Surface::Plane { .. } => "plane", Surface::Cylinder { .. } => "cyl", Surface::Sphere { .. } => "sphere", Surface::Torus { .. } => "torus", Surface::Cone { .. } => "cone", Surface::Spindle { .. } => "spindle", Surface::Nurbs(_) => "nurbs", Surface::Approx(_) => "approx" };
+            let _ = k;
+            kinds.push(kind.to_string());
+            let m = mesh.positions.len() as u32;
+            mesh.positions.push(m_pos);
+            let pos = &mesh.positions;
+            let mut out = Vec::with_capacity(mesh.patches[pi].triangles.len() + 2);
+            for &t in &mesh.patches[pi].triangles {
+                let at = (0..3).find(|&q| { let (x, y) = (t[q], t[(q + 1) % 3]); (x == a && y == b) || (x == b && y == a) });
+                match at {
+                    None => out.push(t),
+                    Some(q) => {
+                        let (x, y, z) = (t[q], t[(q + 1) % 3], t[(q + 2) % 3]);
+                        let pn = cross(sub(pos[y as usize], pos[x as usize]), sub(pos[z as usize], pos[x as usize]));
+                        let mut pmax = 0f64;
+                        let mut cmax = 0f64;
+                        for c in [[x, m, z], [m, y, z]] {
+                            let cn = cross(sub(pos[c[1] as usize], pos[c[0] as usize]), sub(pos[c[2] as usize], pos[c[0] as usize]));
+                            if !(dot(cn, pn) > 0.0) { stats.1 += 1; }
+                            for i in 0..=12 { for j in 0..=(12 - i) {
+                                let (s, t2) = (i as f64 / 12.0, j as f64 / 12.0);
+                                let w = 1.0 - s - t2;
+                                let p0 = pos[c[0] as usize]; let p1 = pos[c[1] as usize]; let p2 = pos[c[2] as usize];
+                                let xp = Point3::new(w*p0.x+s*p1.x+t2*p2.x, w*p0.y+s*p1.y+t2*p2.y, w*p0.z+s*p1.z+t2*p2.z);
+                                if let Some(d) = dev(xp) { cmax = cmax.max(d); }
+                            }}
+                        }
+                        for i in 0..=12 { for j in 0..=(12 - i) {
+                            let (s, t2) = (i as f64 / 12.0, j as f64 / 12.0);
+                            let w = 1.0 - s - t2;
+                            let p0 = pos[x as usize]; let p1 = pos[y as usize]; let p2 = pos[z as usize];
+                            let xp = Point3::new(w*p0.x+s*p1.x+t2*p2.x, w*p0.y+s*p1.y+t2*p2.y, w*p0.z+s*p1.z+t2*p2.z);
+                            if let Some(d) = dev(xp) { pmax = pmax.max(d); }
+                        }}
+                        if cmax > delta { stats.2 += 1; }
+                        stats.5 = stats.5.max(cmax / delta);
+                        stats.6 = stats.6.max(pmax / delta);
+                        out.push([x, m, z]);
+                        out.push([m, y, z]);
+                    }
+                }
+            }
+            mesh.patches[pi].triangles = out;
+            stats.0 += 1;
+        }
+    }
+    let first_new = mesh.positions.len() - stats.0;
+    let mut seen: Vec<[u64; 3]> = mesh.positions[first_new..].iter().map(|p| [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()]).collect();
+    let n0 = seen.len();
+    seen.sort_unstable();
+    seen.dedup();
+    let near = {
+        let ps = &mesh.positions[first_new..];
+        let mut k = 0;
+        for i in 0..ps.len() { for j in i+1..ps.len() { let d = sub(ps[i], ps[j]); if dot(d, d).sqrt() <= delta * 1e-6 { k += 1; } } }
+        k
+    };
+    eprintln!("SURFCOINCIDENT {:?} bitwise {} near {} kinds {:?}", std::thread::current().name(), n0 - seen.len(), near, { let mut k = kinds.clone(); k.sort(); k.dedup(); k });
+    kinds.sort();
+    kinds.dedup();
+    eprintln!("SURFSPLIT cuts {} folds {} devfail {} nofoot {} chorded {} worst_child/d {:.3} worst_parent/d {:.3} kinds {:?}", stats.0, stats.1, stats.2, stats.3, stats.4, stats.5, stats.6, kinds);
+}
