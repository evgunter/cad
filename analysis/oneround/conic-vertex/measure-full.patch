+/// EXPERIMENT: `cos θ − 1` from `sin θ` and `cos θ`, `−sin²/(1 + cos)`
+/// where `cos > 0`, else the plain difference.
+fn cos_less_one<T: Real>(sin: T, cos: T) -> T {
+    let near = T::zero() - sin * sin / (T::one() + cos);
+    cos.select_le_zero(cos - T::one(), near)
+}
+
+fn running_cos_less_one<T: Real>(sin: Rounded<T>, cos: Rounded<T>) -> Rounded<T> {
+    let u = T::from_f64(geom_core::UNIT_ROUNDOFF);
+    let d = T::one() + cos.value;
+    let value = T::zero() - sin.value * sin.value / d;
+    let near = Rounded {
+        value,
+        error: T::from_f64(2.0) * sin.value.abs() * sin.error / d
+            + value.abs() * (cos.error + u * d.abs()) / d
+            + T::from_f64(3.0) * u * value.abs(),
+    };
+    let far = cos - Rounded::exact(T::one());
+    Rounded::select_le_zero(cos.value, far, near)
+}
+
+/// EXPERIMENT: `c + u·a`, exactly rounded in mode 3 where all are points.
+fn vertex_coord<T: Real>(c: T, u: T, a: T) -> T {
+    if vertex_mode() == 3
+        && let (Some(&c0), Some(&u0), Some(&a0)) = (
+            (&c as &dyn core::any::Any).downcast_ref::<f64>(),
+            (&u as &dyn core::any::Any).downcast_ref::<f64>(),
+            (&a as &dyn core::any::Any).downcast_ref::<f64>(),
+        )
+    {
+        let (p, e) = geom_core::exact::two_product(u0, a0);
+        let (s, t) = geom_core::exact::two_sum(c0, p);
+        return T::from_f64(s + (t + e));
+    }
+    c + u * a
+}
+
+fn vertex_of<T: Real>(c: Point3<T>, u: Vec3<T>, a: T) -> Point3<T> {
+    Point3::new(
+        vertex_coord(c.x, u.x, a),
+        vertex_coord(c.y, u.y, a),
+        vertex_coord(c.z, u.z, a),
+    )
+}
+
+fn running_vertex3<T: Real>(c: Rounded<T>, u: Rounded<T>, a: Rounded<T>) -> Rounded<T> {
+    if vertex_mode() == 3 {
+        let value = vertex_coord(c.value, u.value, a.value);
+        return Rounded {
+            value,
+            error: T::from_f64(geom_core::UNIT_ROUNDOFF) * value.abs(),
+        };
+    }
+    running_vertex(c, u * a)
+}
+
+fn running_vertex<T: Real>(c: Rounded<T>, ua: Rounded<T>) -> Rounded<T> {
+    let v = c + ua;
+    if vertex_mode() == 2 {
+        Rounded::exact(v.value)
+    } else {
+        v
+    }
+}
