+/// EXPERIMENT: the apex rung on a far-centred ellipse whose vertex lies
+/// an exactly known distance from the apex.
+#[test]
+fn probe_apex_rung_far_centre() {
+    use geom_core::exact::{two_product, two_sum};
+    let mut rng = 0x1234_5678_9ABC_DEF1_u64;
+    let mut next = || {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        (rng >> 11) as f64 / (1u64 << 53) as f64
+    };
+    for eps in [1e-9, 1e-12] {
+        let b = Band::new(eps, 10.0 * eps).unwrap();
+        for far in [1e3, 1e4, 1e5, 1e6, 1e7] {
+            let (mut total, mut passed_at, mut refused_off) = (0, 0, 0);
+            for _ in 0..4000 {
+                let u = Vec3::new(next() - 0.5, next() - 0.5, next() - 0.5).normalize();
+                let n = u.cross(Vec3::new(0.3, -0.5, 0.8)).normalize();
+                let v0 = Point3::new(next() * 10.0, next() * 10.0, next() * 10.0);
+                let c = v0 - u * far;
+                let frame = geom::Frame::new(c, n, u);
+                let e = geom::Curve3::Ellipse(geom::Ellipse::new(frame, far, far * 0.01));
+                let conic = e.conic().unwrap();
+                let (c, u) = (conic.frame().origin, conic.frame().u_ref);
+                // The stored curve's vertex, exactly: head and tail per coordinate.
+                let vertex = [(c.x, u.x), (c.y, u.y), (c.z, u.z)].map(|(c, u)| {
+                    let (p, e) = two_product(u, far);
+                    let (s, t) = two_sum(c, p);
+                    two_sum(s, t + e)
+                });
+                // The apex `d` off it along a generic direction; the exact gap is `d` to
+                // within the tails and the offset's own rounding, a few 1e-15.
+                let d = eps * 40.0 * next();
+                let dir = Vec3::new(next() - 0.5, next() - 0.5, next() - 0.5).normalize();
+                let apex = Point3::new(
+                    vertex[0].0 + dir.x * d,
+                    vertex[1].0 + dir.y * d,
+                    vertex[2].0 + dir.z * d,
+                );
+                let exact = ((vertex[0].0 - apex.x + vertex[0].1).powi(2)
+                    + (vertex[1].0 - apex.y + vertex[1].1).powi(2)
+                    + (vertex[2].0 - apex.z + vertex[2].1).powi(2))
+                .sqrt();
+                let got = off_the_apex(&conic, apex, CircleRoots::of(&[0.0]).unwrap(), b);
+                total += 1;
+                match got {
+                    Ok(_) if exact <= b.zero() => passed_at += 1,
+                    Err(_) if exact > 2.0 * b.escalate() => refused_off += 1,
+                    _ => {}
+                }
+            }
+            eprintln!(
+                "APEX eps {eps:e} far {far:e}: {total} poses, passed a root within ε of the apex {passed_at}, refused one past 2Kε {refused_off}"
+            );
+        }
+    }
+}
