+/// TEMPORARY PROBE SWITCH. `CV_CHORD=f64`: a centre-held conic is read by
+/// chords from `fl(centre + u·a)` at every scalar but `interval` and
+/// `symbolic`; `CV_CHORD=all`: at every scalar.
+fn cv_chord<T: Real>() -> bool {
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    let m = *MODE.get_or_init(|| match std::env::var("CV_CHORD").as_deref() {
+        Ok("f64") => 1,
+        Ok("all") => 2,
+        _ => 0,
+    });
+    m == 2 || (m == 1 && T::NAME != "interval" && T::NAME != "symbolic")
+}
