+#[test]
+fn probe2_radius_1500_pose() {
+    let eps = 1e-9;
+    let band = Band::new(eps, 10.0 * eps).unwrap();
+    let rho = 1500.0;
+    for (depth, g, b) in [
+        (-2.2275268165499354e-8, 1.2546003706691626, 5.870495587448265),
+        (4.3131436790936147e-7, 1.5655932971058697, 4.7628240842869465),
+        (-3.4093494596693404e-8, 4.918663138591604, 2.7053608505752993),
+    ] {
+        let c = tangent_circle(1.0, rho, depth, g, b);
+        let geom::Curve3::Circle(circle) = c else { panic!() };
+        let f = geom::Conic::frame(&circle);
+        let zero = f.origin() + f.u_ref() * rho;
+        let twin = geom::Curve3::Circle(geom::Circle::anchored(zero, f.axis(), f.u_ref(), rho));
+        for (name, k) in [("centre-held", &c), ("anchored twin", &twin)] {
+            let truth = exact::truth(k, &wall(1.0));
+            let got = conic_quadric_roots(k, -1.0, 1.0, &wall(1.0), band);
+            eprintln!("P2 depth {depth:e} {name}: truth {:?}", truth.roots);
+            eprintln!("P2 depth {depth:e} {name}: door {got:?}");
+        }
+        let tc = exact::truth(&c, &wall(1.0));
+        let tt = exact::truth(&twin, &wall(1.0));
+        for (x, y) in tc.roots.iter().zip(&tt.roots) {
+            eprintln!("P2 depth {depth:e} truths apart {:e} m", arc_between(*x, *y, rho));
+        }
+    }
+}
