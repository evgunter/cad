+#[test]
+fn probe2_interval_contains_f64() {
+    use geom_core::{Bounds, Interval, Real};
+    let lift = <Interval as Real>::from_f64;
+    let mut state = 0x9e3779b97f4a7c15_u64;
+    let mut unit = move || {
+        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((state >> 11) as f64) / ((1u64 << 53) as f64)
+    };
+    for kind in ["circle", "ellipse"] {
+        for s in [1e-3, 1.0, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7] {
+            for span in ["whole turn", "|t| < 1e-3"] {
+                let (mut n, mut miss, mut worst, mut width) = (0, 0, 0.0_f64, 0.0_f64);
+                for _ in 0..3000 {
+                    let mut v = || Vec3::new(2.0 * unit() - 1.0, 2.0 * unit() - 1.0, 2.0 * unit() - 1.0);
+                    let axis = v().normalize();
+                    let u0 = v();
+                    let u_ref = (u0 - axis * u0.dot(axis)).normalize();
+                    let p0 = Point3::origin() + v();
+                    let r = s * (0.5 + 1.5 * unit());
+                    let center = p0 - u_ref * r;
+                    let c = if kind == "circle" {
+                        geom::Curve3::circle(center, axis, r, u_ref)
+                    } else {
+                        geom::Curve3::Ellipse(geom::Ellipse::new(geom::Frame::new(center, axis, u_ref), r, r * (0.2 + 0.7 * unit())))
+                    };
+                    let t = if span == "whole turn" { PI * (2.0 * unit() - 1.0) } else { 1e-3 * (2.0 * unit() - 1.0) };
+                    let p = c.eval(t);
+                    let q = c.map_scalar(lift).eval(lift(t));
+                    n += 1;
+                    let mut out = 0.0_f64;
+                    for (x, e) in [(p.x, q.x), (p.y, q.y), (p.z, q.z)] {
+                        out = out.max(e.lo() - x).max(x - e.hi());
+                        width = width.max(e.hi() - e.lo());
+                    }
+                    if out > 0.0 {
+                        miss += 1;
+                        worst = worst.max(out);
+                    }
+                }
+                eprintln!("P2A {kind} size {s:e} {span}: {miss} of {n} f64 points outside the Interval point, worst {worst:e} m out, widest enclosure {width:e} m");
+            }
+        }
+    }
+}
