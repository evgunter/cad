+#[test]
+fn probe_far_door_decisions() {
+    use geom::Conic as _;
+    use geom_core::{Bounds, Interval, Real};
+    let lift = <Interval as Real>::from_f64;
+    let u = geom_core::UNIT_ROUNDOFF;
+    let floor = geom_core::tolerance::ADMISSION_FLOOR;
+    let file = std::fs::read_to_string(std::env::var("CV_IN").expect("CV_IN")).unwrap();
+    let mut reframed = 0;
+    for (eps, k) in [(1e-9, 10.0), (1e-9, 1.002), (1e-12, 10.0), (1e-12, 2.81)] {
+        let band = Band::new(eps, k * eps).unwrap();
+        println!("FAR run eps {eps:e} K {k} admissible {} | R = box*(K-1)*eps/floor = {:.4e} m | (K-1)*eps/u = {:.4e} m", geom_core::tolerance::admissible(eps, k), 1e3 * (k - 1.0) * eps / floor, (k - 1.0) * eps / u);
+        for line in file.lines().filter(|l| l.starts_with("EDGE ")) {
+            let w: Vec<&str> = line.split_whitespace().collect();
+            let (door, d, kind) = (w[1], w[2], w[5]);
+            let n: Vec<f64> = w[6..19].iter().map(|h| f64::from_bits(u64::from_str_radix(h, 16).unwrap())).collect();
+            let (o, ax, ur) = (Point3::new(n[0], n[1], n[2]), Vec3::new(n[3], n[4], n[5]), Vec3::new(n[6], n[7], n[8]));
+            let frame = geom::Frame::admitted(o, ax, ur).unwrap_or_else(|| { reframed += 1; geom::Frame::new(o, ax, ur) });
+            let (a, b, t0, t1) = (n[9], n[10], n[11], n[12]);
+            let centre = match kind { "circle" => geom::Curve3::Circle(geom::Circle::new(frame, a)), _ => geom::Curve3::Ellipse(geom::Ellipse::new(frame, a, b)) };
+            let zero = frame.origin() + frame.u_ref() * a;
+            let chord = match kind { "circle" => geom::Curve3::Circle(geom::Circle::anchored(zero, frame.axis(), frame.u_ref(), a)), _ => geom::Curve3::Ellipse(geom::Ellipse::anchored(zero, frame.axis(), frame.u_ref(), a, b)) };
+            let tm = 0.5 * (t0 + t1);
+            for (form, c, judge) in [("centre-sum", &centre, &centre), ("chord", &chord, &chord), ("chord-vs-stored-centre", &chord, &centre)] {
+                for lane in ["f64", "Interval"] {
+                    let (mut right, mut right_spacing, mut inband, mut wrong) = (0, 0, 0, 0); let mut worst = 0.0_f64;
+                    let mut refusals = std::collections::BTreeMap::<String, usize>::new();
+                    let mut wrongs = Vec::new();
+                    let p = centre.eval(tm);
+                    let n_hat = (frame.origin() - p).normalize();
+                    let t_hat = centre.deriv(tm).normalize();
+                    for m in [0.3, 0.6, 1.0, 2.0, 5.0, 20.0, 100.0, 500.0] {
+                        for sgn in [-1.0, 1.0] {
+                            for g in [1.2_f64, 1.1, 1.3] {
+                                let depth = sgn * m * k * eps;
+                                let axis = t_hat * g.sin() + n_hat.cross(t_hat) * g.cos();
+                                let w_surf = geom::Surface::Cylinder { frame: geom::Frame::new(p - n_hat * (1.0 + depth), axis, n_hat), radius: 1.0 };
+                                let truth = exact::truth(judge, &w_surf);
+                                let near = |x: f64| { let mut y = x; while y - tm > PI { y -= TAU; } while y - tm < -PI { y += TAU; } y };
+                                let true_roots: Vec<f64> = truth.roots.iter().map(|&x| near(x)).filter(|x| *x >= t0 && *x <= t1).collect();
+                                let got: Result<Result<Vec<f64>, String>, String> = if lane == "f64" {
+                                    match conic_quadric_roots(c, t0, t1, &w_surf, band) {
+                                        Ok(Ok(CircleRoots::Certified(f))) => Ok(Ok(f.roots().to_vec())),
+                                        Ok(Ok(CircleRoots::Miss)) => Ok(Ok(Vec::new())),
+                                        Ok(Ok(CircleRoots::On(_))) => Ok(Err("On".into())),
+                                        Ok(Err(e)) => Ok(Err(format!("{e:?}"))),
+                                        Err(e) => Err(format!("{e:?}")),
+                                    }
+                                } else {
+                                    match conic_quadric_roots(&c.map_scalar(lift), lift(t0), lift(t1), &w_surf.map_scalar(lift), band) {
+                                        Ok(Ok(CircleRoots::Certified(f))) => Ok(Ok(f.roots().iter().map(|r| 0.5 * (r.lo() + r.hi())).collect())),
+                                        Ok(Ok(CircleRoots::Miss)) => Ok(Ok(Vec::new())),
+                                        Ok(Ok(CircleRoots::On(_))) => Ok(Err("On".into())),
+                                        Ok(Err(e)) => Ok(Err(format!("{e:?}"))),
+                                        Err(e) => Err(format!("{e:?}")),
+                                    }
+                                };
+                                match got {
+                                    Ok(Ok(roots)) => {
+                                        let spacing = 8.0 * f64::EPSILON * a;
+                                        let off = |tol: f64| roots.len() == true_roots.len() && roots.iter().all(|&t| true_roots.iter().map(|&x| (near(t) - x).abs() * a).fold(f64::INFINITY, f64::min) <= tol);
+                                        if off(eps) { right += 1 } else if off(eps.max(spacing)) { right_spacing += 1 } else if depth.abs() <= k * eps * 1.0000001 || truth.depth < k * eps { inband += 1 } else {
+                                            wrong += 1;
+                                            if roots.len() == true_roots.len() { for &t in &roots { worst = worst.max(true_roots.iter().map(|&x| (near(t) - x).abs() * a).fold(f64::INFINITY, f64::min)); } } else { worst = f64::INFINITY; }
+                                            wrongs.push(format!("depth {depth:e} g {g}: door {roots:?} truth-in-window {true_roots:?} (truth depth {:e})", truth.depth));
+                                        }
+                                    }
+                                    Ok(Err(e)) => *refusals.entry(e.chars().take(60).collect()).or_default() += 1,
+                                    Err(e) => *refusals.entry(format!("Err {}", e.chars().take(56).collect::<String>())).or_default() += 1,
+                                }
+                            }
+                        }
+                    }
+                    println!("FAR eps {eps:e} K {k} {door} D {d} {kind} a {a:.4e} span {:.3e} {form} {lane}: right {right} right-to-spacing {right_spacing} in-band-mismatch {inband} WRONG {wrong} worst {worst:e} refused {refusals:?}{}", t1 - t0, if wrongs.is_empty() { String::new() } else { format!("\n  {}", wrongs.join("\n  ")) });
+                }
+            }
+        }
+    }
+    println!("FAR frames re-squared (not admitted bit for bit): {reframed}");
+}
