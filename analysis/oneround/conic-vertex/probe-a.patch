+#[cfg(test)]
+#[allow(clippy::all, clippy::pedantic, clippy::unwrap_used)]
+mod vertex_probe_a4 {
+    use super::*;
+    use geom_core::{Point3, Vec3};
+
+    struct Lcg(u64);
+    impl Lcg {
+        fn f(&mut self) -> f64 {
+            self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            ((self.0 >> 11) as f64) / ((1u64 << 53) as f64)
+        }
+        fn s(&mut self) -> f64 {
+            2.0 * self.f() - 1.0
+        }
+    }
+    fn hx(x: f64) -> String {
+        format!("{:016x}", x.to_bits())
+    }
+
+    /// `row_interval`'s decision at one end: the carrier at `r` against `p`.
+    #[test]
+    fn probe_dump() {
+        let mut rng = Lcg(0xa4ea_5eed);
+        let n = Vec3::new(0.0, 0.0, 1.0);
+        for &eps in &[1e-9, 1e-12] {
+            let band = Band::new(eps, 10.0 * eps).unwrap();
+            for &far in &[1e4, 1e5, 1e6, 1e7] {
+                for &ratio in &[0.01, 1.0] {
+                    for _ in 0..1500 {
+                        let phi = 3.2 * rng.s();
+                        let u = Vec3::new(phi.cos(), phi.sin(), 0.0);
+                        let v = Vec3::new(-u.y, u.x, 0.0);
+                        let v0 = Point3::new(10.0 * rng.s(), 10.0 * rng.s(), 0.0);
+                        let (sa, sb) = (far, far * ratio);
+                        let c = v0 - u * sa;
+                        let carrier = geom::Curve3::Ellipse(geom::Ellipse::new(geom::Frame::new(c, n, u), sa, sb));
+                        let r = rng.s() / sb;
+                        let h = (r * 0.5).sin();
+                        let w = (10.0 * eps).max(8.0 * f64::EPSILON * far);
+                        let scale = if rng.f() < 0.5 { 12.0 * eps } else { 3.0 * w };
+                        let psi = 3.2 * rng.s();
+                        let off = Vec3::new(psi.cos(), psi.sin(), 0.0) * (scale * rng.f());
+                        let p = v0 + (u * (sa * (-2.0 * h * h)) + v * (sb * r.sin())) + off;
+                        let got = match decide("pcurve_row_interval", Margin::of(carrier.eval(r).distance(p)), band) {
+                            Ok(Sign::Zero) => 0,
+                            Ok(_) => 1,
+                            Err(_) => 2,
+                        };
+                        println!(
+                            "S4 {eps:e} {far:e} {ratio} {} {} {} {} {} {} {} {} {} {got}",
+                            hx(c.x), hx(c.y), hx(u.x), hx(u.y), hx(sa), hx(sb), hx(r), hx(p.x), hx(p.y)
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
