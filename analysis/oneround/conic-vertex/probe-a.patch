+#[cfg(test)]
+#[allow(clippy::all, clippy::pedantic, clippy::unwrap_used)]
+mod vertex_probe_a3 {
+    use super::*;
+    use geom::Conic;
+    use geom_core::Vec3;
+
+    struct Lcg(u64);
+    impl Lcg {
+        fn f(&mut self) -> f64 {
+            self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            ((self.0 >> 11) as f64) / ((1u64 << 53) as f64)
+        }
+        fn s(&mut self) -> f64 {
+            2.0 * self.f() - 1.0
+        }
+    }
+    fn hx(x: f64) -> String {
+        format!("{:016x}", x.to_bits())
+    }
+    fn less_sin(d: f64) -> f64 {
+        let q = d * d;
+        d * q / 6.0 * (1.0 - q / 20.0 * (1.0 - q / 42.0 * (1.0 - q / 72.0)))
+    }
+
+    /// The site's arithmetic for a loop of one chord and one conic arc
+    /// from `a_pt` to `b_pt`, the origin at `a_pt`.
+    #[test]
+    fn probe_dump() {
+        let mut rng = Lcg(0xa3ea_5eed);
+        let n = Vec3::new(0.0, 0.0, 1.0);
+        for &eps in &[1e-9, 1e-12] {
+            let band = Band::new(eps, 10.0 * eps).unwrap();
+            for &far in &[1e4, 1e5, 1e6, 1e7] {
+                for &ratio in &[0.01, 1.0] {
+                    for _ in 0..1500 {
+                        let phi = 3.2 * rng.s();
+                        let u = Vec3::new(phi.cos(), phi.sin(), 0.0);
+                        let v0 = Point3::new(10.0 * rng.s(), 10.0 * rng.s(), 0.0);
+                        let (sa, sb) = (far, far * ratio);
+                        let c = v0 - u * sa;
+                        let e = geom::Ellipse::new(geom::Frame::new(c, n, u), sa, sb);
+                        let w = (10.0 * eps).max(8.0 * f64::EPSILON * far);
+                        let scale = if rng.f() < 0.5 { 12.0 * eps } else { 3.0 * w };
+                        let m = scale * rng.f();
+                        let delta = (12.0 * m / sa).sqrt();
+                        let t0 = -delta * rng.f();
+                        let t1 = t0 + delta;
+                        let (a_pt, b_pt) = (e.point_at(t0), e.point_at(t1));
+                        let origin = a_pt;
+                        let dt = t1 - t0;
+                        let chord = (b_pt - a_pt).norm();
+                        let perimeter = chord + chord + (e.speed_hi() * dt.abs() - chord);
+                        let excess = (c - origin).cross(b_pt - a_pt).dot(n) + sa * sb * e.frame().axis.dot(n) * dt;
+                        let read = |twice: f64| {
+                            match decide("split_section_area", Margin::over_lever(twice.abs(), perimeter), band) {
+                                Ok(Sign::Positive) => 1,
+                                Ok(_) => 0,
+                                Err(_) => 2,
+                            }
+                        };
+                        let main = read(excess);
+                        let posed = read(sa * sb * e.frame().axis.dot(n) * less_sin(dt));
+                        println!(
+                            "S3 {eps:e} {far:e} {ratio} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {main} {posed}",
+                            hx(c.x), hx(c.y), hx(u.x), hx(u.y), hx(sa), hx(sb), hx(t0), hx(t1),
+                            hx(a_pt.x), hx(a_pt.y), hx(b_pt.x), hx(b_pt.y), hx(perimeter), hx(excess), hx(dt)
+                        );
+                    }
+                }
+            }
+        }
+    }
