+/// TEMPORARY PROBE 3.
+#[derive(Default)]
+struct Cell {
+    right: usize,
+    wrong: usize,
+    refused: usize,
+    worst: f64,
+}
+
+impl Cell {
+    fn judge(&mut self, got: &Result<Vec<f64>, ()>, truth: &[f64], a: f64, eps: f64, near: &dyn Fn(f64) -> f64) {
+        match got {
+            Err(()) => self.refused += 1,
+            Ok(roots) => {
+                let judge = eps + 8.0 * a * (f64::EPSILON / 2.0);
+                let offs: Vec<f64> = roots
+                    .iter()
+                    .map(|&t| truth.iter().map(|&x| (near(t) - near(x)).abs() * a).fold(f64::INFINITY, f64::min))
+                    .collect();
+                if roots.len() == truth.len() && offs.iter().all(|&o| o <= judge) {
+                    self.right += 1;
+                } else {
+                    self.wrong += 1;
+                    self.worst = self.worst.max(if roots.len() == truth.len() { offs.iter().fold(0.0, |m, &o| m.max(o)) } else { f64::INFINITY });
+                }
+            }
+        }
+    }
+    fn show(&self) -> String {
+        format!("{}/{}/{} worst {:.2e}", self.right, self.wrong, self.refused, self.worst)
+    }
+}
+
+fn probe3_door(c: &geom::Curve3<f64>, t0: f64, t1: f64, w: &geom::Surface<f64>, band: Band) -> Result<Vec<f64>, ()> {
+    match conic_quadric_roots(c, t0, t1, w, band) {
+        Ok(Ok(CircleRoots::Certified(f))) => Ok(f.roots()[..f.count()].to_vec()),
+        Ok(Ok(CircleRoots::Miss)) => Ok(Vec::new()),
+        _ => Err(()),
+    }
+}
+
+fn probe3_truths(c: &geom::Curve3<f64>, w: &geom::Surface<f64>, t0: f64, t1: f64, near: &dyn Fn(f64) -> f64) -> [Vec<f64>; 2] {
+    [false, true].map(|polar| {
+        exact::CV_POLAR.store(polar, std::sync::atomic::Ordering::Relaxed);
+        let t = exact::truth(c, w);
+        exact::CV_POLAR.store(false, std::sync::atomic::Ordering::Relaxed);
+        t.roots.iter().map(|&x| near(x)).filter(|x| *x >= t0 && *x <= t1).collect()
+    })
+}
