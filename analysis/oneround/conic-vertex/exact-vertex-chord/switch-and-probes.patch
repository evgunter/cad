+        let ((uh, ul), (ah, al)) = (split(u), split(a));
+        let e1 = ((uh * ah - p) + uh * al + ul * ah) + ul * al;
+        let s = c + p;
+        let bb = s - c;
+        let e2 = (c - (s - bb)) + (p - bb);
+        let lo = e1 + e2;
+        let hi = s + lo;
+        (hi, lo - (hi - s))
+    };
+    let ((hx, lx), (hy, ly), (hz, lz)) = (one(c.x, u.x), one(c.y, u.y), one(c.z, u.z));
