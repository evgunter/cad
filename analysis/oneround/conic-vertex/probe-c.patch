@@ -1062,3 +1062,61 @@ pub(super) fn cylinder_cylinder<T: Decide>(
         components,
     })
 }
+
+#[cfg(test)]
+#[allow(clippy::all, clippy::pedantic, clippy::unwrap_used, clippy::panic, clippy::print_stdout)]
+mod conic_vertex_probe {
+    use super::*;
+    use geom_core::exact::two_sum;
+
+    /// A far ellipse along x̂ whose near major vertex stands `gap` (exact,
+    /// by two_sum) from a region ball on its axis; the listing filter's
+    /// `Outside` is wrong where the vertex is in or within eps of the ball.
+    #[test]
+    fn probe_listing_filter() {
+        for eps in [1e-9, 1e-12] {
+            let band = Band::new(eps, 10.0 * eps).unwrap();
+            for far in [1e4, 1e5, 1e6, 1e7] {
+                let (mut outside, mut wrong, mut total, mut worst) = (0, 0, 0, 0.0f64);
+                let (mut err, mut under) = (0.0f64, 0.0f64);
+                for k in 0..2000 {
+                    let kf = f64::from(k);
+                    let cx = far + 0.731 + 1.3e-3 * kf + 0.917e-7 * kf;
+                    let radius = 0.4 + 1e-4 * kf;
+                    // vertex x = cx - far, exactly (hi, lo)
+                    let (vh, vl) = two_sum(cx, -far);
+                    // region centre left of the vertex by radius + target
+                    let target = (f64::from(k % 41) - 20.0) * (eps * 2.0).max(far * 2e-17);
+                    let xr = vh - radius - target;
+                    // exact clearance: (vertex - xr) - radius
+                    let (d, de) = two_sum(vh, -xr);
+                    let (g, ge) = two_sum(d, -radius);
+                    let truth = g + (ge + de + vl);
+                    let e = Curve3::Ellipse(geom::Ellipse::new(
+                        geom::Frame::new(
+                            Point3::new(cx, 0.0, 0.0),
+                            Vec3::new(0.0, 0.0, 1.0),
+                            Vec3::new(-1.0, 0.0, 0.0),
+                        ),
+                        far,
+                        far / 100.0,
+                    ));
+                    let ball = ExtentBall::of_covered(e.cover().as_ref().ok());
+                    let region = ExtentBall::fixture(Point3::new(xr, 0.0, 0.0), radius);
+                    total += 1;
+                    let m = (ball.center() - region.center()).norm() - (region.radius() + ball.radius());
+                    err = err.max((m - truth).abs());
+                    under = under.min(m - truth);
+                    if placement(ball, region, band) == RegionPlacement::Outside {
+                        outside += 1;
+                        if truth < eps {
+                            wrong += 1;
+                            worst = worst.min(truth);
+                        }
+                    }
+                }
+                println!("LISTING eps {eps:e} far {far:e}: Outside {outside}/{total}, wrong (true clearance < eps) {wrong}, worst true clearance {worst:e}; margin-truth max abs {err:e}, most negative {under:e}");
+            }
+        }
+    }
+}
diff --git a/crates/geom-brep/src/pcurve_cache.rs b/crates/geom-brep/src/pcurve_cache.rs
index 685df7d53..d5357aa3b 100644
--- a/crates/geom-brep/src/pcurve_cache.rs
+++ b/crates/geom-brep/src/pcurve_cache.rs
@@ -17460,3 +17460,69 @@ mod general_arm_rows {
         let _ = envelope_verdict(1.0_f64, band, || PcurveCheck::ChartIncidence);
     }
 }
+
+#[cfg(test)]
+#[allow(clippy::all, clippy::pedantic, clippy::unwrap_used, clippy::panic, clippy::print_stdout)]
+mod conic_vertex_probe {
+    use super::*;
+    use geom_core::exact::{two_product, two_sum};
+
+    /// origin + u*x + v*y per coordinate, truth as (hi, lo).
+    fn exact_coord(ux: f64, x: f64, vy: f64, y: f64) -> (f64, f64) {
+        let (p, pe) = two_product(ux, x);
+        let (q, qe) = two_product(vy, y);
+        let (s, se) = two_sum(p, q);
+        (s, se + pe + qe)
+    }
+
+    #[test]
+    fn probe_plane_arm() {
+        let normal = Vec3::new(0.0, 0.0, 1.0);
+        let u_ref = Vec3::new(0.6, 0.8, 0.0);
+        let v_ref = normal.cross(u_ref);
+        let surface = Surface::Plane { origin: Point3::origin(), normal, u_ref };
+        for eps in [1e-9, 1e-12] {
+            let band = Band::new(eps, 10.0 * eps).unwrap();
+            for far in [1e4, 1e5, 1e6, 1e7] {
+                let (mut ok, mut wrong, mut refused, mut worst) = (0, 0, 0, 0.0f64);
+                let mut kinds = std::collections::BTreeMap::<String, u32>::new();
+                for k in 0..400 {
+                    let p0x = -far + 1.0 + 0.37 * f64::from(k) / 400.0 + 0.123_456_789e-3 * f64::from(k);
+                    let p0y = 0.3 + 0.211 * f64::from(k) / 400.0;
+                    let u = Channel::Free { c: p0x, a: far, b: 0.0, l: 0.0 };
+                    let v = Channel::Free { c: p0y, a: 0.0, b: far / 100.0, l: 0.0 };
+                    let img = plane_image(harmonic_form_of(u, v), Point3::origin(), normal, u_ref);
+                    let carrier = Curve3::Ellipse(geom::Ellipse::new(
+                        geom::Frame::new(img.c, normal, u_ref),
+                        far,
+                        far / 100.0,
+                    ));
+                    // true image centre less the stored one
+                    let mut d2 = 0.0;
+                    for (uu, vv, c) in [(u_ref.x, v_ref.x, img.c.x), (u_ref.y, v_ref.y, img.c.y), (u_ref.z, v_ref.z, img.c.z)] {
+                        let (hi, lo) = exact_coord(uu, p0x, vv, p0y);
+                        let d = (hi - c) + lo;
+                        d2 += d * d;
+                    }
+                    let truth = d2.sqrt();
+                    worst = worst.max(truth);
+                    let span = 10.0 / far;
+                    match run_harmonic_checks((u, v), -span, span, &carrier, &surface, band, None) {
+                        Ok(_) => {
+                            ok += 1;
+                            if truth > eps {
+                                wrong += 1;
+                            }
+                        }
+                        Err(e) => {
+                            refused += 1;
+                            let s = format!("{e:?}");
+                            *kinds.entry(s.chars().take(60).collect()).or_default() += 1;
+                        }
+                    }
+                }
+                println!("PLANEARM eps {eps:e} far {far:e}: certified {ok} (true centre gap > eps: {wrong}), refused {refused}, worst true gap {worst:e} {kinds:?}");
+            }
+        }
+    }
+}
