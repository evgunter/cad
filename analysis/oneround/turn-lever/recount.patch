+                format!("{key}\tvertex_out={worst_v:e}\tvertex_off_surface={worst_v_off:e}\tedge_point_out={worst_pts:e}\tedge_point_off_surface={worst_pts_off:e}\tedge_cover_out={worst_e:e}"),
+            );
+        }
+    }
