+//! turn-lever measurement probe (not for merge): which cover read gives a
+//! finite value with a NaN derivative on `Dual<f64>`.
+use geom::cover::{Cover, ParamWindow, Site};
+use geom::{Frame, Line};
+use geom_core::{Dual64, Point3, Vec3, Real};
+
+fn c(x: f64) -> Dual64 { Dual64::constant(x) }
+fn p(x: f64, y: f64, z: f64) -> Point3<Dual64> { Point3::new(c(x), c(y), c(z)) }
+fn v(x: f64, y: f64, z: f64) -> Vec3<Dual64> { Vec3::new(c(x), c(y), c(z)) }
+
+fn show(name: &str, cov: Option<Cover<Dual64>>, lines: &[(&str, Line<Dual64>)]) {
+    let Some(cov) = cov else { println!("TLDUAL\t{name}\tNone"); return };
+    for (ln, l) in lines {
+        let (n, f) = cov.distance_range(&Site::Line(*l));
+        println!("TLDUAL\t{name}\t{ln}\tnear=({:e},{:e})\tfar=({:e},{:e})", n.value, n.deriv, f.value, f.deriv);
+    }
+}
+
+#[test]
+fn tl_dual_cover_probe() {
+    let fr = Frame::new(p(0.0, 0.0, 0.0), v(0.0, 0.0, 1.0), v(1.0, 0.0, 0.0));
+    let lines = [
+        ("axis", Line { origin: p(0.0, 0.0, 0.0), dir: v(0.0, 0.0, 1.0) }),
+        ("off-axis-parallel", Line { origin: p(0.3, 0.2, 0.0), dir: v(0.0, 0.0, 1.0) }),
+        ("skew", Line { origin: p(2.0, 0.0, 0.0), dir: v(0.0, 1.0, 0.5) }),
+        ("through-surface", Line { origin: p(1.0, 0.0, 0.0), dir: v(0.0, 1.0, 0.0) }),
+    ];
+    let w = |a: f64, b: f64| ParamWindow::new(c(a), c(b));
+    show("sphere", Cover::sphere(&fr, c(1.0)), &lines);
+    show("torus", Cover::torus(&fr, c(2.0), c(0.5)), &lines);
+    show("patch-sphere", Cover::patch(&fr, (c(0.0), c(1.0)), Some(w(0.0, 1.0)), w(0.0, 0.5)), &lines);
+    show("patch-sphere-zone", Cover::patch(&fr, (c(0.0), c(1.0)), None, w(-0.5, 0.5)), &lines);
+    show("patch-torus", Cover::patch(&fr, (c(2.0), c(0.5)), Some(w(0.0, 1.0)), w(0.0, 0.5)), &lines);
+    let pts = Cover::points(vec![p(0.0, 0.0, 0.0), p(0.0, 0.0, 1.0)]).unwrap();
+    show("wall-in-points", Cover::wall(&fr, c(1.0), &pts), &lines);
+    show("cone-in-points", Cover::cone(&fr, c(0.5), &pts), &lines);
+    show("points", Some(pts.clone()), &lines);
+    show("segment", Cover::segment(p(1.0, 0.0, 0.0), p(1.0, 1.0, 0.0)), &lines);
+    show("arc", Cover::arc(&fr, (c(1.0), c(1.0)), w(0.0, 1.0)), &lines);
+    let wall = Cover::wall(&fr, c(1.0), &pts).unwrap();
+    show("wall.meet(patch)", Some(wall.clone().meet(Cover::patch(&fr, (c(0.0), c(1.0)), Some(w(0.0, 1.0)), w(0.0, 0.5)).unwrap())), &lines);
+    show("hull.convex", Some(wall.hull(pts).convex()), &lines);
+    let _ = Dual64::constant(0.0).sqrt();
+}
