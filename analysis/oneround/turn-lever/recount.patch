@@ -0,0 +1,42 @@
+//! Measurement only: the open row's extrude table at the lever site in use.
+use geom_core::{Arc2, Point2, Tol};
+use ::profile::{Profile, ProfileLoop, RawLoop, Segment, SketchPlane};
+use sweep::{ExtrudeSide, Extrusion, Revolution, RevolveAxis, extrude, revolve};
+
+fn wall_arc(x0: f64, phi: f64) -> Profile<f64> {
+    let h = std::f64::consts::FRAC_PI_2 + phi;
+    let p1 = Point2::new(x0, 0.05);
+    let c = Point2::new(p1.x - h.sin(), p1.y + h.cos());
+    let a0 = (p1.y - c.y).atan2(p1.x - c.x);
+    let q = Point2::new(c.x + (a0 + 0.05).cos(), c.y + (a0 + 0.05).sin());
+    Profile::new(SketchPlane::xy(), vec![ProfileLoop::new(vec![
+        (Point2::new(x0, 0.0), Segment::Line),
+        (p1, Segment::Arc(Arc2 { centre: c, radius: 1.0, sweep: 0.05 })),
+        (q, Segment::Line),
+        (Point2::new(x0 - 0.1, 0.0), Segment::Line),
+    ])])
+}
+
+#[test]
+fn tl_g1_row_table() {
+    let tol = Tol::witness();
+    let eps = tol.eps();
+    let site = std::env::var("TL_SITE").unwrap_or_else(|_| "middle".into());
+    for m in [5.0, 10.0, 15.0, 19.0] {
+        let p = wall_arc(20.0, m * eps);
+        let v = match p.validate(tol) { Ok(v) => v, Err(e) => { println!("G1ROW\t{site}\tphi={m}eps\tprofile refuses: {e:?}"); continue } };
+        let tangent = !v.loops()[0].tangent_joints().is_empty();
+        for depth in [1.0, 4.0] {
+            let got = extrude(&v, Extrusion::Distance { depth, side: ExtrudeSide::Along }, tol);
+            let out = match got {
+                Ok(e) => match topo::validate(&e.body) { Ok(()) => "builds, tier 3 passes".to_string(), Err(es) => format!("builds, tier 3 refuses: {:?}", es.first()) },
+                Err(e) => format!("{e}"),
+            };
+            println!("G1ROW\t{site}\tphi={m}eps\tprofile_tangent={tangent}\textrude depth {depth}\t{}", out.chars().take(300).collect::<String>());
+        }
+        let axis = RevolveAxis { origin: Point2::new(0.0, 0.0), dir: geom_core::Vec2::new(0.0, 1.0) };
+        let got = revolve(&v, axis, Revolution::Partial(1.0), tol);
+        let out = match got { Ok(_) => "builds".to_string(), Err(e) => format!("{e}") };
+        println!("G1ROW\t{site}\tphi={m}eps\tprofile_tangent={tangent}\trevolve 1 rad\t{}", out.chars().take(300).collect::<String>());
+    }
+}
