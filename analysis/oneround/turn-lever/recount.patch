+}
+
+/// Measurement only: open a decision recorder.
+#[doc(hidden)]
+pub fn tl_rec_start() {
+    tl_rec_start_forced(Vec::new());
+}
+
+/// Measurement only: open a decision recorder whose `i`-th decision
+/// returns as `force` says: `S` a straddle refusal, `+`/`-`/`0` that sign.
+#[doc(hidden)]
+pub fn tl_rec_start_forced(force: Vec<(usize, u8)>) {
+    TL_REC.with(|r| r.borrow_mut().push(Vec::new()));
+    TL_FORCE.with(|f| f.borrow_mut().push(force));
+}
+
+/// Measurement only: close the innermost recorder, handing its
+/// decisions to the one outside it too.
+#[doc(hidden)]
+pub fn tl_rec_take() -> Vec<(&'static str, u8)> {
+    TL_REC.with(|r| {
+        let mut r = r.borrow_mut();
+        TL_FORCE.with(|f| f.borrow_mut().pop());
+        let v = r.pop().unwrap_or_default();
+        if let Some(p) = r.last_mut() {
+            p.extend(v.iter().copied());
+        }
+        v
+    })
+}
