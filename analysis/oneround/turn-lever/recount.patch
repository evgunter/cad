+//! Measurement only (never committed as behaviour).
+#![allow(missing_docs, clippy::all, clippy::pedantic)]
+use std::any::Any;
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::fmt::Debug;
+
+use geom_core::{Lever, Real};
+
+struct Agg {
+    counts: HashMap<String, u64>,
+    details: Vec<String>,
+    per_key: HashMap<String, u32>,
+}
+
+impl Drop for Agg {
+    fn drop(&mut self) {
+        let Some(p) = path() else { return };
+        let t = test();
+        let mut out = String::new();
+        for (k, v) in &self.counts {
+            out.push_str(&format!("A\t{t}\t{k}\t{v}\n"));
+        }
+        for d in &self.details {
+            out.push_str(&format!("D\t{t}\t{d}\n"));
+        }
+        line(&p, out.trim_end());
+    }
+}
+
+thread_local! {
+    static ABOVE: RefCell<HashMap<String, Box<dyn Any>>> = RefCell::new(HashMap::new());
+    static IN: Cell<bool> = const { Cell::new(false) };
+    static AGG: RefCell<Agg> = RefCell::new(Agg {
+        counts: HashMap::new(),
+        details: Vec::new(),
+        per_key: HashMap::new(),
+    });
+}
+
+thread_local! {
+    static TIER3: Cell<bool> = const { Cell::new(false) };
+    static PHASES: RefCell<PhaseMap> = RefCell::new(PhaseMap(HashMap::new()));
+}
+
+struct PhaseMap(HashMap<u64, (Option<String>, Option<String>, String)>);
+impl Drop for PhaseMap {
+    fn drop(&mut self) {
+        let Some(p) = path() else { return };
+        let t = test();
+        let mut c: HashMap<String, u64> = HashMap::new();
+        let mut out = String::new();
+        {
+            for (door, tier3, what) in self.0.values() {
+                let k = match (door, tier3) {
+                    (Some(a), Some(b)) if a == b => format!("MF\t{what}\tsame"),
+                    (Some(a), Some(b)) => {
+                        out.push_str(&format!("D\t{t}\tMF-DIFF\t{what}\tdoor={a}\ttier3={b}\n"));
+                        format!("MF\t{what}\tDIFFERENT")
+                    }
+                    (Some(_), None) => format!("MF\t{what}\tdoor_only"),
+                    (None, Some(_)) => format!("MF\t{what}\ttier3_only"),
+                    (None, None) => continue,
+                };
+                *c.entry(k).or_insert(0) += 1;
+            }
+        }
+        for (k, v) in c {
+            out.push_str(&format!("A\t{t}\t{k}\t{v}\n"));
+        }
+        line(&p, out.trim_end());
+    }
+}
+
+pub struct Tier3Guard(bool);
+impl Drop for Tier3Guard {
+    fn drop(&mut self) {
+        TIER3.with(|f| f.set(self.0));
+    }
+}
+pub fn tier3() -> Tier3Guard {
+    Tier3Guard(TIER3.with(|f| f.replace(true)))
+}
+
+/// M-f: the verdict a door and tier 3 each reach on one keyed read.
+pub fn phase_verdict(what: &str, key: u64, action: String) {
+    if path().is_none() || IN.with(Cell::get) {
+        return;
+    }
+    let t3 = TIER3.with(Cell::get);
+    PHASES.with(|m| {
+        let mut m = m.borrow_mut();
+        let e = m.0.entry(key).or_insert((None, None, what.to_string()));
+        if t3 {
+            e.1.get_or_insert(action);
+        } else {
+            e.0.get_or_insert(action);
+        }
+    });
+}
+
+pub fn hash_of(parts: &[String]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    parts.hash(&mut h);
+    h.finish()
+}
+
+thread_local! {
+    static FOLD: Cell<(u32, u32, bool)> = const { Cell::new((0, 0, false)) };
+}
+
+/// Item 2: whether a fold's least term was the reach or a curvature arm.
+pub fn fold_seen(curv: Option<f64>, reach: Option<f64>) {
+    FOLD.with(|f| {
+        let (r, c, on) = f.get();
+        if !on {
+            return;
+        }
+        match (curv, reach) {
+            (Some(k), Some(x)) if x <= k => f.set((r + 1, c, on)),
+            (Some(_), Some(_)) => f.set((r, c + 1, on)),
+            _ => {}
+        }
+    });
+}
+
+/// The order-free key and the must-carry class of a verdict, for M-f's
+/// must-carry half: a door's must-carry verdict against tier 3's fold.
+pub fn mc_class(v: &str) -> &'static str {
+    if v.starts_with("Crease") || v.starts_with("Transverse") {
+        "corner"
+    } else if v.starts_with("JetDeterminate") {
+        "determinate"
+    } else if v.starts_with("UnderDetermined") || v.starts_with("Lamina") {
+        "under-determined"
+    } else if v.starts_with("Seam") || v.starts_with("End") {
+        if v.contains("UnderDetermined") { "under-determined" } else { "determinate" }
+    } else if v.starts_with("Mixed") {
+        "mixed"
+    } else {
+        "in-band"
+    }
+}
+
+pub fn mc_key(a: String, b: String, carrier: String, span: String) -> u64 {
+    let (a, b) = if a <= b { (a, b) } else { (b, a) };
+    hash_of(&["mcwv".into(), a, b, carrier, span])
+}
+
+pub fn is_tier3() -> bool {
+    TIER3.with(Cell::get)
+}
+
+pub fn class_of_below<T: Real>(below: Lever<T>) -> String {
+    TAGS.with(|m| m.borrow().get(&format!("{:?}", below.length())).map_or("-".to_string(), |(c, _)| c.clone()))
+}
+
+pub fn poison_of<T: Real>(below: Lever<T>) -> Option<bool> {
+    lookup(below).map(|(a, _): (Lever<T>, Lever<T>)| format!("{:?}", a.length()).contains("NaN"))
+}
+
+pub fn path() -> Option<String> {
+    std::env::var("TL_SHADOW").ok()
+}
+
+pub fn active() -> bool {
+    path().is_some() && !IN.with(Cell::get)
+}
+
+thread_local! {
+    static G2_DEPTH: Cell<u32> = const { Cell::new(0) };
+}
+
+struct Depth;
+impl Depth {
+    fn enter() -> Self {
+        G2_DEPTH.with(|d| d.set(d.get() + 1));
+        Depth
+    }
+}
+impl Drop for Depth {
+    fn drop(&mut self) {
+        G2_DEPTH.with(|d| d.set(d.get() - 1));
+    }
+}
+
+fn nested() -> bool {
+    G2_DEPTH.with(Cell::get) > 0
+}
+
+pub fn g2() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("TL_G2").is_some())
+}
+
+fn refused(v: &str) -> bool {
+    v.contains("InBand") || v.starts_with("Err") || v.contains("Undecided") || v.contains("Escalat")
+}
+
+/// G2 (i): the run's own verdict under the two-sided rule. Every
+/// decision is read at `below` and at `above`. A definite sign stands
+/// on `below`; a Zero on `below` stands only where `above` reads Zero;
+/// an escalation on `below` stands. Each other pair is forced: a Zero
+/// at `below` against anything else at `above` refuses in band in both
+/// runs; a definite sign at `below` is handed to `above`'s run, so its
+/// path follows the verdict's. Repeated until the paths agree.
+#[allow(clippy::too_many_arguments)]
+fn two_sided<T: Real, R: Debug>(
+    name: &str,
+    below: Lever<T>,
+    above: Lever<T>,
+    mid: Option<Lever<T>>,
+    truth: Option<f64>,
+    class: String,
+    run: &impl Fn(Lever<T>) -> R,
+    action: &impl Fn(&R) -> String,
+) -> R {
+    let _depth = Depth::enter();
+    let ln = lane::<T>();
+    let mut fb: Vec<(usize, u8)> = Vec::new();
+    let mut fa: Vec<(usize, u8)> = Vec::new();
+    let mut straddles = 0;
+    let mut out = None;
+    let mut last_sb: Vec<u8> = Vec::new();
+    for _ in 0..16 {
+        geom_core::k_stats::tl_rec_start_forced(fb.clone());
+        let r = run(below);
+        let sb = geom_core::k_stats::tl_rec_take();
+        last_sb = sb.iter().map(|&(_, b)| b).collect();
+        IN.with(|f| f.set(true));
+        let ((_ra, sa), _) = geom_core::k_stats::detached(|| {
+            geom_core::k_stats::tl_rec_start_forced(fa.clone());
+            let ra = run(above);
+            (ra, geom_core::k_stats::tl_rec_take())
+        });
+        IN.with(|f| f.set(false));
+        let mut new = false;
+        for i in 0..sb.len().min(sa.len()) {
+            if fb.iter().any(|(j, _)| *j == i) || fa.iter().any(|(j, _)| *j == i) {
+                continue;
+            }
+            let ((p, b), (q, a)) = (sb[i], sa[i]);
+            if p != q {
+                count(format!("G2-DIVERGE\t{name}\t{ln}"));
+                break;
+            }
+            if a == b {
+                continue;
+            }
+            match b {
+                b'0' => {
+                    count(format!("G2-STRADDLE\t{name}\t{ln}\t{p}\t0\t{}\t{class}", a as char));
+                    detail(&format!("G2-STRADDLE\t{name}\t{p}\t{class}"), format!("G2-STRADDLE\t{name}\t{p}\t{class}\tbelow={:?}\tabove={:?}\tabove_sign={}", below.length(), above.length(), a as char));
+                    fb.push((i, b'S'));
+                    fa.push((i, b'S'));
+                    straddles += 1;
+                }
+                b'E' => fa.push((i, b'S')),
+                _ => {
+                    if a != b'E' {
+                        count(format!("G2-WRONGDIR\t{name}\t{ln}\t{p}\t{}\t{}\t{class}", b as char, a as char));
+                    }
+                    fa.push((i, b));
+                }
+            }
+            new = true;
+            break;
+        }
+        if !new {
+            out = Some(r);
+            break;
+        }
+        out = Some(r);
+    }
+    let r = out.expect("one pass ran");
+    let v = action(&r);
+    let rf = refused(&v);
+    count(format!("G2-VERDICT\t{name}\t{ln}\t{}\tstraddled={}\t{class}", if rf { "refused" } else { "served" }, straddles > 0));
+    if let Some(door) = inverted(below) {
+        let zero = last_sb.iter().enumerate().any(|(i, &b)| b == b'0' && !fb.iter().any(|(j, _)| *j == i));
+        let act: String = v.trim().chars().take_while(|c| !matches!(c, '{' | '(' | ' ')).collect();
+        count(format!("INV-VERDICT\t{name}\t{ln}\t{door}\t{}\tzero_stood={zero}\t{act}\t{class}", if rf { "refused" } else { "served" }));
+        detail(&format!("INV-VERDICT\t{name}\t{door}\t{zero}"), format!("INV-VERDICT\t{name}\tdoor={door}\tclass={class}\tverdict={}\tzero_stood={zero}\tbelow={:?}\tabove={:?}", v.trim(), below.length(), above.length()));
+    }
+    IN.with(|f| f.set(true));
+    if let Some(m) = mid {
+        let (rm, _) = geom_core::k_stats::detached(|| run(m));
+        let vm = action(&rm);
+        if vm != v {
+            count(format!("G2-MOVED\t{name}\t{ln}\t{class}\t{}\t{}", vm.trim(), v.trim()));
+            detail(&format!("G2-MOVED\t{name}\t{class}\t{}\t{}", vm.trim(), v.trim()), format!("G2-MOVED\t{name}\t{class}\tmiddle={}\tg2={}\tbelow={:?}\tabove={:?}\tmid={:?}", vm.trim(), v.trim(), below.length(), above.length(), m.length()));
+        }
+    }
+    if let (Some(t), "f64") = (truth, ln) {
+        let tl = Lever::of_consumed_extent(T::from_f64(t));
+        let (rt, _) = geom_core::k_stats::detached(|| run(tl));
+        let vt = action(&rt);
+        let dir = if vt == v { "equal" } else if rf { "refused-where-truth-serves" } else if refused(&vt) { "SERVED-where-truth-refuses" } else { "SERVED-OTHER-than-truth" };
+        count(format!("G2-TRUTH\t{name}\t{class}\t{dir}"));
+        if dir.starts_with("SERVED") {
+            detail(&format!("G2-PAST\t{name}\t{class}"), format!("G2-PAST\t{name}\t{class}\t{dir}\tg2={v:?}\ttruth_verdict={vt:?}\tbelow={:?}\tabove={:?}\ttruth={t:e}", below.length(), above.length()));
+        }
+    }
+    IN.with(|f| f.set(false));
+    r
+}
+
+fn compare_on() -> bool {
+    std::env::var_os("TL_NO_COMPARE").is_none()
+}
+
+pub fn add(key: String, n: u64) {
+    AGG.with(|a| *a.borrow_mut().counts.entry(key).or_insert(0) += n);
+}
+
+pub fn count(key: String) {
+    AGG.with(|a| *a.borrow_mut().counts.entry(key).or_insert(0) += 1);
+}
+
+pub fn detail(key: &str, d: String) {
+    AGG.with(|a| {
+        let mut a = a.borrow_mut();
+        let n = a.per_key.entry(key.to_string()).or_insert(0);
+        *n += 1;
+        if *n <= 5 {
+            a.details.push(d);
+        }
+    });
+}
+
+thread_local! {
+    static TAGS: RefCell<HashMap<String, (String, Option<f64>)>> = RefCell::new(HashMap::new());
+}
+
+pub fn register_tagged<T: Real>(below: Lever<T>, above: Lever<T>, mid: Lever<T>, class: &str, truth: Option<f64>) {
+    register(below, above, mid);
+    if active() {
+        // The latest read of this bound from below decides whether it is
+        // inverted: a read that is not clears an earlier one's mark.
+        if !INV_PENDING.with(|p| p.replace(false)) {
+            INV.with(|m| m.borrow_mut().remove(&format!("{:?}", below.length())));
+        }
+        TAGS.with(|m| {
+            let mut m = m.borrow_mut();
+            if m.len() > 200_000 { m.clear(); }
+            m.insert(format!("{:?}", below.length()), (class.to_string(), truth));
+        });
+    }
+}
+
+thread_local! {
+    static INV: RefCell<HashMap<String, String>> = RefCell::new(HashMap::new());
+    static INV_PENDING: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// The recount: a door read whose unfolded cover falls short of its bound
+/// from below by more than the band's zero, keyed by the bound from below.
+pub fn mark_inverted<T: Real>(below: Lever<T>, door: String) {
+    if active() {
+        INV.with(|m| {
+            let mut m = m.borrow_mut();
+            if m.len() > 200_000 { m.clear(); }
+            m.insert(format!("{:?}", below.length()), door);
+        });
+        INV_PENDING.with(|p| p.set(true));
+    }
+}
+
+fn inverted<T: Real>(below: Lever<T>) -> Option<String> {
+    INV.with(|m| m.borrow().get(&format!("{:?}", below.length())).cloned())
+}
+
+fn tag_full<T: Real>(below: Lever<T>) -> (String, Option<f64>) {
+    TAGS.with(|m| m.borrow().get(&format!("{:?}", below.length())).cloned().unwrap_or(("-".to_string(), None)))
+}
+
+fn tag_of<T: Real>(below: Lever<T>) -> String {
+    TAGS.with(|m| m.borrow().get(&format!("{:?}", below.length())).map_or("-".to_string(), |(c, t)| {
+        let tv = format!("{:?}", below.length()).parse::<f64>().ok();
+        let at_truth = match (t, tv) { (Some(t), Some(v)) => if (v - t).abs() <= 1e-12 * (1.0 + t) { "below=truth" } else { "below!=truth" }, _ => "no-truth" };
+        format!("{c}/{at_truth}")
+    }))
+}
+
+pub fn register<T: Real>(below: Lever<T>, above: Lever<T>, below_d: Lever<T>) {
+    if !active() {
+        return;
+    }
+    ABOVE.with(|m| {
+        let mut m = m.borrow_mut();
+        if m.len() > 200_000 {
+            m.clear();
+        }
+        m.insert(format!("{:?}", below.length()), Box::new((above, below_d)));
+    });
+}
+
+fn lookup<T: Real>(below: Lever<T>) -> Option<(Lever<T>, Lever<T>)> {
+    ABOVE.with(|m| {
+        m.borrow()
+            .get(&format!("{:?}", below.length()))
+            .and_then(|b| b.downcast_ref::<(Lever<T>, Lever<T>)>().copied())
+    })
+}
+
+pub fn action_of<R: Debug>(r: &R) -> String {
+    format!("{r:?}")
+        .chars()
+        .take_while(|c| !matches!(c, '{' | '0'..='9' | '-'))
+        .collect()
+}
+
+fn lane<T: 'static>() -> &'static str {
+    let n = std::any::type_name::<T>();
+    if n == "f64" {
+        "f64"
+    } else if n.contains("Interval") && !n.contains("Dual") {
+        "Interval"
+    } else if n.contains("Dual") {
+        "Dual"
+    } else {
+        "Sym"
+    }
+}
+
+pub fn shadow<T: Real, R: Debug>(
+    name: &str,
+    below: Lever<T>,
+    run: impl Fn(Lever<T>) -> R,
+    action: impl Fn(&R) -> String,
+) -> R {
+    if !active() || !compare_on() {
+        return run(below);
+    }
+    if g2() && nested() {
+        return run(below);
+    }
+    if g2() {
+        return match lookup(below) {
+            Some((above, mid)) => {
+                let (class, truth) = tag_full(below);
+                two_sided(name, below, above, Some(mid), truth, class, &run, &action)
+            }
+            None => {
+                count(format!("UNREG\t{name}\t{}", lane::<T>()));
+                run(below)
+            }
+        };
+    }
+    match lookup(below) {
+        Some((above, below_d)) => compare(name, below, above, Some(below_d), &run, &action),
+        None => {
+            count(format!("UNREG\t{name}\t{}", lane::<T>()));
+            run(below)
+        }
+    }
+}
+
+pub fn shadow_both<T: Real, R: Debug>(
+    name: &str,
+    below: Lever<T>,
+    above: Lever<T>,
+    run: impl Fn(Lever<T>) -> R,
+    action: impl Fn(&R) -> String,
+) -> R {
+    if !active() || !compare_on() {
+        return run(below);
+    }
+    if g2() && nested() {
+        return run(below);
+    }
+    if g2() {
+        let (class, truth) = tag_full(below);
+        let mid = lookup(below).map(|(_, m)| m);
+        return two_sided(name, below, above, mid, truth, class, &run, &action);
+    }
+    let d = lookup(below).map(|(_, d)| d);
+    compare(name, below, above, d, &run, &action)
+}
+
+fn recorded<R>(f: impl FnOnce() -> R) -> (R, Vec<(&'static str, u8)>) {
+    geom_core::k_stats::tl_rec_start();
+    let r = f();
+    (r, geom_core::k_stats::tl_rec_take())
+}
+
+fn kind_of<R: Debug>(a: &R, b: &R, action: &impl Fn(&R) -> String) -> &'static str {
+    if format!("{a:?}") == format!("{b:?}") {
+        "EQ"
+    } else if action(a) == action(b) {
+        "PAYLOAD"
+    } else {
+        "ACTION"
+    }
+}
+
+fn compare<T: Real, R: Debug>(
+    name: &str,
+    below: Lever<T>,
+    above: Lever<T>,
+    below_d: Option<Lever<T>>,
+    run: &impl Fn(Lever<T>) -> R,
+    action: &impl Fn(&R) -> String,
+) -> R {
+    FOLD.with(|f| f.set((0, 0, true)));
+    let (r, sb) = recorded(|| run(below));
+    let (fr, fc, _) = FOLD.with(|f| f.replace((0, 0, false)));
+    IN.with(|f| f.set(true));
+    let ((r2, s2), _) = geom_core::k_stats::detached(|| recorded(|| run(below)));
+    IN.with(|f| f.set(false));
+    let det = if format!("{r:?}") != format!("{r2:?}") {
+        "verdict-differs"
+    } else if sb.len() != s2.len() {
+        "same-verdict-count-differs"
+    } else if sb != s2 {
+        "same-verdict-decisions-differ"
+    } else {
+        "same"
+    };
+    count(format!("DET\t{name}\t{det}"));
+    if det != "same" {
+        detail(&format!("DET\t{name}\t{det}"), format!("DET\t{name}\t{det}\tfirst={}\tsecond={}", sb.len(), s2.len()));
+    }
+    IN.with(|f| f.set(true));
+    let ((ra, sa), _) = geom_core::k_stats::detached(|| recorded(|| run(above)));
+    let d = below_d.map(|l| geom_core::k_stats::detached(|| recorded(|| run(l))).0);
+    IN.with(|f| f.set(false));
+    let ln = lane::<T>();
+    let poison = format!("{:?}", above.length()).contains("NaN");
+    let kind = kind_of(&r, &ra, action);
+    count(format!("C\t{name}\t{ln}\t{kind}\tpoison={poison}"));
+    if ln == "f64" && fr + fc > 0 {
+        count(format!("FOLD\t{name}\t{kind}\t{}", if fr > 0 { "reach-least-at-some-station" } else { "curvature-least-everywhere" }));
+    }
+    if poison {
+        let v = action(&r);
+        count(format!("POISONV\t{name}\t{v}\t{}", class_of_below(below)));
+        detail(&format!("POISONV\t{name}\t{v}"), format!("POISONV\t{name}\t{v}\t{}", class_of_below(below)));
+    }
+    let pairs = |tag: &str, x: &[(&'static str, u8)], y: &[(&'static str, u8)], k: &str, lo: String| {
+        let n = x.len().min(y.len());
+        for i in 0..n {
+            let (p, a) = x[i];
+            let (q, b) = y[i];
+            let key = format!(
+                "{tag}\t{name}\t{ln}\t{p}\t{}\t{}\tcomposite={k}\tpoison={poison}",
+                a as char, b as char
+            );
+            count(key.clone());
+            if p != q || a != b {
+                if p != q {
+                    count(format!("{tag}-PRED-MISMATCH\t{name}\t{p}\t{q}"));
+                }
+                detail(
+                    &key,
+                    format!("{key}\tbelow={lo}\tabove={:?}\tat={i}", above.length()),
+                );
+                return;
+            }
+        }
+        if x.len() != y.len() {
+            count(format!("{tag}-LEN\t{name}\t{ln}\t{}\t{}", x.len(), y.len()));
+        }
+    };
+    pairs("P", &sb, &sa, kind, format!("{:?}", below.length()));
+    if let (Some((rd, sd)), Some(l)) = (d, below_d) {
+        let kd = kind_of(&rd, &ra, action);
+        let kb = kind_of(&r, &rd, action);
+        let tag = tag_of(below);
+        count(format!("CD\t{name}\t{ln}\tvs_above={kd}\tvs_below={kb}\tpoison={poison}\t{tag}"));
+        if kb != "EQ" {
+            detail(&format!("G1MOVE\t{name}\t{tag}\t{kb}"), format!("G1MOVE\t{name}\t{tag}\t{kb}\tline={}\tmiddle={}\tline_verdict={}\tmiddle_verdict={}", format!("{:?}", below.length()), format!("{:?}", l.length()), action(&r), action(&rd)));
+        }
+        pairs("PD", &sd, &sa, kd, format!("{:?}", l.length()));
+    }
+    r
+}
+
+fn test() -> String {
+    std::thread::current().name().unwrap_or("?").to_string()
+}
+
+fn line(p: &str, s: &str) {
+    use std::io::Write;
+    if s.is_empty() {
+        return;
+    }
+    if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true).open(p) {
+        let _ = f.write_all(format!("{s}\n").as_bytes());
+    }
+}
