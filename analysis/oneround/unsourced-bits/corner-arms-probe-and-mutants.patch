+    /// REVIEW PROBE (PR 7227): the corner solve ACTS on the conditioning's
+    /// Zero (it answers the tangent foot), so the arm it is levered at is
+    /// not a refuse-on-Zero lever. A line–circle pair (profile radius 1)
+    /// whose roots stand `±4e-6` off the foot, read at the arm a half-turn
+    /// edge of radius `0.1` had (`π·0.1`, its arc length) and has (`2·0.1`,
+    /// its diameter, `edge_extent_inf`), under the band `(1e-6, 1e-5)`:
+    /// the old arm escalates (the solve refuses), the new arm reads Zero
+    /// and answers the foot, `4e-6` (four zero-bands) off either root.
+    #[test]
+    fn review_probe_the_shorter_arm_answers_a_foot_where_the_arc_length_refused() {
+        let band = Band::new(1e-6, 1e-5).unwrap();
+        let delta = 8e-12;
+        let pair = [station(11.0 - delta), CIRCLE];
+        let at = |arm: f64| {
+            let arms = [geom_core::test_support::fixture_lever(arm)];
+            solve_pairs(&pair, &arms, (11.0, 4e-6), VertexKey::default(), band)
+        };
+        let r_edge = 0.1;
+        let old = at(std::f64::consts::PI * r_edge);
+        let new = at(2.0 * r_edge);
+        eprintln!("old (arc length): {old:?}\nnew (diameter): {new:?}");
+        assert!(
+            matches!(old, Err(ReplaceFaceError::Escalated { .. })),
+            "the arc-length arm refuses: {old:?}"
+        );
+        let (rho, h) = new.unwrap().expect("the diameter arm answers");
+        // The pair's two true roots.
+        let half = (1.0 - (1.0 - delta) * (1.0 - delta)).sqrt();
+        let off = ((rho - (11.0 - delta)).powi(2) + (h - half).powi(2)).sqrt();
+        eprintln!("answered ({rho}, {h}); nearer root (11 - δ, {half:e}); off by {off:e}");
+        assert!(off > band.zero(), "the foot is more than a zero band off the root: {off:e}");
+    }
+
