+fn sfg_stand<T: Decide>(site: &'static str, ball: geom_brep::ExtentBall<T>, q: Point3<T>) -> T {
+    let old = (q - ball.center()).norm() - ball.lever().length();
+    let new = ball.stand_off(q);
+    geom_core::sfg_probe::hit(site, core::any::type_name::<T>(), &old, &new);
+    if format!("{new:?}").starts_with('-') {
+        geom_core::sfg_probe::hit("neg_raw", site, &0, &0);
+    } else {
+        geom_core::sfg_probe::hit("pos_raw", site, &0, &0);
+    }
+    if geom_core::sfg_probe::mutant(&format!("pos_{site}")) {
+        return new.abs() + T::from_f64(1e9);
+    }
+    if geom_core::sfg_probe::mutant(&format!("neg_{site}")) {
+        return -new.abs() - T::from_f64(1e9);
+    }
+    new
