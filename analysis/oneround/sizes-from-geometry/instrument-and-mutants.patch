+fn sfg_shrunk<T: Decide>(name: &str, ball: geom_brep::ExtentBall<T>) -> geom_brep::ExtentBall<T> {
+    if geom_core::sfg_probe::mutant(name) {
+        geom_brep::ExtentBall::unsourced(ball.center(), ball.radius() * T::from_f64(0.5))
+    } else {
+        ball
+    }
+}
