new file mode 100644
index 000000000..a79baf811
--- /dev/null
+++ b/crates/geom-core/src/sfg_probe.rs
@@ -0,0 +1,60 @@
+//! REVIEW INSTRUMENT (not for merge): counts reads of each converted
+//! site per lane and logs every read whose old and new values differ.
+#![allow(missing_docs, clippy::all, clippy::pedantic, clippy::nursery)]
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::io::Write;
+
+struct Tally(BTreeMap<(&'static str, &'static str), (u64, u64)>);
+
+impl Drop for Tally {
+    fn drop(&mut self) {
+        let Ok(path) = std::env::var("SFG_LOG") else { return };
+        let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) else {
+            return;
+        };
+        let mut out = String::new();
+        for ((site, lane), (n, d)) in &self.0 {
+            let who = std::env::var("NEXTEST_TEST_NAME").ok().or_else(|| std::thread::current().name().map(str::to_owned)).unwrap_or_default();
+            let bin = std::env::var("NEXTEST_BINARY_ID").unwrap_or_default();
+            out.push_str(&format!("TALLY\t{site}\t{lane}\t{n}\t{d}\t{bin}\t{who}\n"));
+        }
+        let _ = f.write_all(out.as_bytes());
+    }
+}
+
+thread_local! {
+    static TALLY: RefCell<Tally> = RefCell::new(Tally(BTreeMap::new()));
+}
+
+pub fn hit<A: core::fmt::Debug, B: core::fmt::Debug>(
+    site: &'static str,
+    lane: &'static str,
+    old: &A,
+    new: &B,
+) {
+    let (o, n) = (format!("{old:?}"), format!("{new:?}"));
+    let differs = o != n;
+    let _ = TALLY.try_with(|t| {
+        let mut t = t.borrow_mut();
+        let e = t.0.entry((site, lane)).or_insert((0, 0));
+        e.0 += 1;
+        if differs {
+            e.1 += 1;
+        }
+    });
+    if differs {
+        if let Ok(path) = std::env::var("SFG_LOG") {
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                let _ = f.write_all(format!("DIFF\t{site}\t{lane}\t{o}\t{n}\n").as_bytes());
+            }
+        }
+    }
+}
+
+static MUTANT: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+
+/// Whether the planted mutant `name` is armed (`SFG_MUT=name`).
+pub fn mutant(name: &str) -> bool {
+    MUTANT.get_or_init(|| std::env::var("SFG_MUT").ok()).as_deref() == Some(name)
+}
