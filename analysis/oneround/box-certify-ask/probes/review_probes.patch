+/// C4 and robustness: check 0 runs before the span is read
+/// (`ReadSpec::of`), on the spec as handed. Spans and data no door
+/// validated: does the ask panic, and what does it answer?
+#[test]
+fn c4_unvalidated_spans_and_data_at_check_zero() {
+    let band = band_at(1e-9);
+    let o = Point3::origin();
+    let x = Point3::new(1.0, 0.0, 0.0);
+    let circle = Curve3::circle(o, Vec3::unit_z(), 1.0, Vec3::unit_x());
+    let line = Curve3::line(o, Vec3::unit_x());
+    let spline = rational_arc(1.0, 0.7);
+    let spans: [(f64, f64); 9] = [
+        (0.0, f64::NAN),
+        (f64::NAN, 1.0),
+        (0.0, f64::INFINITY),
+        (f64::NEG_INFINITY, f64::INFINITY),
+        (0.0, 1e300),
+        (-1e18, 1e18),
+        (2.0, 5.0),
+        (-3.0, -2.0),
+        (0.5, 0.5),
+    ];
+    for (name, c) in [("line", &line), ("circle", &circle), ("spline", &spline)] {
+        for span in spans {
+            let got = std::panic::catch_unwind(|| edge_in_box(c, span, (o, x), band));
+            eprintln!("{name} over {span:?}: {}", got.as_ref().map_or("PANIC", |g| kind(g)));
+        }
+    }
+    // Ends that are not finite, and an end past the box on an uncovered edge.
+    let nan = Point3::new(f64::NAN, 0.0, 0.0);
+    eprintln!("nan end: {}", kind(&edge_in_box(&line, (0.0, 1.0), (o, nan), band)));
+    eprintln!("nan end + far end: {}", kind(&edge_in_box(&line, (0.0, 1.0), (Point3::new(5e3, 0.0, 0.0), nan), band)));
+    let nan_line = Curve3::line(o, Vec3::new(f64::NAN, 0.0, 0.0));
+    eprintln!("nan line, ends in: {}", kind(&edge_in_box(&nan_line, (0.0, 1.0), (o, x), band)));
+    eprintln!("nan line, end 5 km out: {}", kind(&edge_in_box(&nan_line, (0.0, 1.0), (o, Point3::new(5e3, 0.0, 0.0)), band)));
+    eprintln!("inf line span, far end: {}", kind(&edge_in_box(&line, (0.0, f64::INFINITY), (o, Point3::new(5e3, 0.0, 0.0)), band)));
+}
