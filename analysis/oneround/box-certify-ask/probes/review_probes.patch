+/// C8: the ask's cost on a few edges (wall time, this build's profile).
+#[test]
+fn c8_cost_of_the_ask() {
+    use std::time::Instant;
+    let band = band_at(1e-9);
+    let line = (Curve3::line(Point3::origin(), Vec3::unit_x()), (0.0, 1.0));
+    let circle = (Curve3::circle(Point3::origin(), Vec3::new(0.3, 0.4, 0.5).normalize(), 2.0, Vec3::new(0.3, 0.4, 0.5).normalize().orthonormal_basis().0), (0.1, 2.0));
+    let ellipse = (Curve3::ellipse(Point3::origin(), Vec3::unit_z(), 3.0, 2.0, Vec3::unit_x(), band).unwrap(), (0.1, 2.0));
+    let spline = (rational_arc(5.0, 0.7), (0.0, 1.0));
+    let knots = KnotVector::clamped((0..24).map(|k| f64::from((k - 3).clamp(0, 17))).collect(), 3).unwrap();
+    let control: Vec<_> = (0..20).map(|k| Point3::new(f64::from(k), f64::from(k % 3), f64::from(k % 5))).collect();
+    let long = (Curve3::Nurbs(Arc::new(geom::NurbsCurve3::new(knots, control, vec![1.0; 20]).unwrap())), (0.5, 16.5));
+    let spiric = Curve3::spiric(Point3::origin(), Vec3::unit_z(), Vec3::unit_x(), 3.0, 1.0, 0.5, band).ok().map(|s| (s, (0.1, 1.0)));
+    let far_line = (Curve3::line(Point3::new(2e3, 0.0, 0.0), Vec3::unit_x()), (0.0, 1.0));
+    let mut cases = vec![("line", line), ("circle", circle), ("ellipse", ellipse), ("spline deg2 3pt", spline), ("spline deg3 20pt", long), ("far line (refused)", far_line)];
+    if let Some(s) = spiric {
+        cases.push(("spiric", s));
+    }
+    for (name, (c, span)) in &cases {
+        let ends = (c.eval(span.0), c.eval(span.1));
+        let n = 20_000u32;
+        let t = Instant::now();
+        let mut ok = 0u32;
+        for _ in 0..n {
+            ok += u32::from(std::hint::black_box(edge_in_box(std::hint::black_box(c), *span, ends, band)).is_ok());
+        }
+        let per = t.elapsed().as_secs_f64() / f64::from(n);
+        eprintln!("{name}: {:.2} us per ask ({} in)", per * 1e6, ok);
+    }
+}
