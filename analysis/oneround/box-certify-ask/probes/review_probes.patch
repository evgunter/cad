+//! Reviewer probes for PR 7272 (frozen head cc67fa2e). Dropped in as
+//! `crates/geom-brep/src/session_box/review_probes.rs` by
+//! `probes/review_probes.patch`; every row prints what it measured and
+//! asserts only what the README promises.
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::print_stderr)]
+
+use super::*;
+use geom_core::spline::KnotVector;
+use geom_core::{Tol, Vec3};
+use std::sync::Arc;
+
+fn band_at(eps: f64) -> Band {
+    Band::linear_at(Tol::witness(), eps).unwrap()
+}
+
+fn kind(r: &Result<(), BoxRefusal<()>>) -> &'static str {
+    match r {
+        Ok(()) => "in",
+        Err(BoxRefusal::Point { .. }) => "POINT",
+        Err(BoxRefusal::Unshown { .. }) => "unshown",
+        Err(BoxRefusal::Uncovered(())) => "uncovered",
+    }
+}
+
+fn ask(c: &Curve3<f64>, span: (f64, f64), band: Band) -> Result<(), BoxRefusal<()>> {
+    edge_in_box(c, span, (c.eval(span.0), c.eval(span.1)), band)
+}
+
+/// The true largest |coordinate| of the edge, by a dense scan.
+fn dense_reach(c: &Curve3<f64>, span: (f64, f64)) -> f64 {
+    let n = 200_000;
+    (0..=n)
+        .map(|k| {
+            let t = span.0 + (span.1 - span.0) * f64::from(k) / f64::from(n);
+            let p = c.eval(t);
+            p.x.abs().max(p.y.abs()).max(p.z.abs())
+        })
+        .fold(0.0, f64::max)
+}
+
+/// A circle arc's largest |coordinate| from its crests: per world axis
+/// the two crest angles of `c_i + r(u_i cos t + v_i sin t)`, each taken
+/// where it falls in the span, and the two ends.
+fn crest_reach(c: &Curve3<f64>, span: (f64, f64)) -> f64 {
+    let Curve3::Circle(circ) = c else { panic!() };
+    let (u, a) = (circ.frame.u_ref, circ.frame.axis);
+    let v = a.cross(u);
+    let tau = core::f64::consts::TAU;
+    let mut ts = vec![span.0, span.1];
+    for (ui, vi) in [(u.x, v.x), (u.y, v.y), (u.z, v.z)] {
+        let crest = vi.atan2(ui);
+        for half in 0..2 {
+            let base = crest + f64::from(half) * core::f64::consts::PI;
+            let k0 = ((span.0 - base) / tau).ceil();
+            let mut t = base + k0 * tau;
+            while t <= span.1 {
+                ts.push(t);
+                t += tau;
+            }
+        }
+    }
+    ts.into_iter()
+        .map(|t| {
+            let p = c.eval(t);
+            p.x.abs().max(p.y.abs()).max(p.z.abs())
+        })
+        .fold(0.0, f64::max)
+}
+
+struct Lcg(u64);
+impl Lcg {
+    fn next(&mut self) -> f64 {
+        self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((self.0 >> 11) as f64) / ((1u64 << 53) as f64)
+    }
+    fn sym(&mut self) -> f64 {
+        2.0 * self.next() - 1.0
+    }
+}
+
+fn tilted_circle(rng: &mut Lcg, scale: f64) -> (Curve3<f64>, (f64, f64)) {
+    let axis = Vec3::new(rng.sym(), rng.sym(), rng.sym()).normalize();
+    let u = axis.orthonormal_basis().0;
+    let c = Point3::new(rng.sym() * scale, rng.sym() * scale, rng.sym() * scale);
+    let r = (0.05 + rng.next()) * scale;
+    let t0 = rng.sym() * 3.0;
+    let t1 = t0 + 0.05 + rng.next() * 6.0;
+    (Curve3::circle(c, axis, r, u), (t0, t1))
+}
+
+/// C3, circle arcs in general position: the ask against a dense scan of
+/// the arc, 4000 arcs with reach drawn in [400, 1600] m, at three bands.
+/// Sound both ways means: reach < 1000 - 1e-3 is "in"; reach > 1000 + 1e-3
+/// is POINT (the circle's inside read is claimed exact).
+#[test]
+fn c3_circle_arcs_against_a_dense_scan() {
+    for eps in [1e-6, 1e-9, 1e-12] {
+        let band = band_at(eps);
+        let mut rng = Lcg(7);
+        let (mut n_in, mut n_point, mut n_unshown, mut wrong) = (0, 0, 0, 0);
+        for _ in 0..4000 {
+            let (c, span) = tilted_circle(&mut rng, 700.0);
+            let reach = dense_reach(&c, span);
+            let got = ask(&c, span, band);
+            match kind(&got) {
+                "in" => n_in += 1,
+                "POINT" => n_point += 1,
+                _ => n_unshown += 1,
+            }
+            let want = if reach < 1000.0 - 1e-3 {
+                "in"
+            } else if reach > 1000.0 + 1e-3 {
+                "POINT"
+            } else {
+                continue;
+            };
+            if kind(&got) != want {
+                wrong += 1;
+                eprintln!("eps {eps}: reach {reach} want {want} got {got:?}");
+            }
+        }
+        eprintln!("circle arcs eps {eps}: in {n_in} point {n_point} other {n_unshown} wrong {wrong}");
+        assert_eq!(wrong, 0);
+    }
+}
+
+/// C3, the band of the box's edge at 1e-12: a tilted circle arc scaled
+/// so its dense reach is 1000 m less `d`, for d from 1e-12 to 1e-9.
+/// "Geometry within the band of the box's edge is in it", and geometry
+/// short of the edge certainly is.
+#[test]
+fn c3_circle_arcs_just_inside_the_box_at_the_finest_band() {
+    let band = band_at(1e-12);
+    let mut rng = Lcg(11);
+    let mut refused = 0;
+    for i in 0..2000 {
+        let (c0, span) = tilted_circle(&mut rng, 300.0);
+        let Curve3::Circle(circ) = &c0 else { panic!() };
+        let reach0 = crest_reach(&c0, span);
+        let d = [1e-9, 1e-10, 1e-11, 3e-12][i % 4];
+        let s = (1000.0 - d) / reach0;
+        let o = Point3::origin();
+        let c = Curve3::circle(
+            o + (circ.frame.origin - o) * s,
+            circ.frame.axis,
+            circ.radius() * s,
+            circ.frame.u_ref,
+        );
+        let reach = crest_reach(&c, span);
+        if reach > 1000.0 {
+            continue;
+        }
+        let got = ask(&c, span, band);
+        if got.is_err() {
+            refused += 1;
+            eprintln!("d {d}: crest reach 1000 - {:e}: {got:?}", 1000.0 - reach);
+        }
+    }
+    eprintln!("just-inside circle arcs refused at 1e-12: {refused}");
+    assert_eq!(refused, 0, "an arc short of the box's edge is refused");
+}
