+/// C4: can an edge the box has not shown inside end up certified? A line
+/// whose span is finite but whose stated ends are not on it and one
+/// stated end is NaN, etc. Each through `EdgeCurve::certify`.
+#[test]
+fn c4_uncovered_edges_through_certify() {
+    use crate::{EdgeCurve, EdgeCurveSpec, NurbsLane};
+    let band = band_at(1e-9);
+    let o = Point3::origin();
+    let x = Point3::new(1.0, 0.0, 0.0);
+    let lever = || geom_core::test_support::fixture_lever(1.0);
+    let nan = Point3::new(f64::NAN, 0.0, 0.0);
+    let cases = [
+        ("nan end", EdgeCurveSpec::line_between(o, x), o, nan),
+        ("degenerate line_between(p,p)", EdgeCurveSpec::line_between(o, o), o, o),
+        ("degenerate far line_between(p,p)", EdgeCurveSpec::line_between(Point3::new(5e3, 0.0, 0.0), Point3::new(5e3, 0.0, 0.0)), Point3::new(5e3, 0.0, 0.0), Point3::new(5e3, 0.0, 0.0)),
+        ("inf end", EdgeCurveSpec::line_between(o, x), o, Point3::new(f64::INFINITY, 0.0, 0.0)),
+    ];
+    for (name, spec, a, b) in cases {
+        let got = EdgeCurve::certify(spec, a, b, |_| None, lever(), band, NurbsLane::certified());
+        eprintln!("{name}: {:?}", got.map(drop));
+    }
+}
