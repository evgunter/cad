 /// between check 2 and the canonical description, then the sampled
 /// checks and C2's limbs through `lane`.
 #[allow(clippy::too_many_arguments)] // one parameter per named quantity
+thread_local! { static REVIEW_UNCOVERED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+
+fn review_write(line: &str) {
+    use std::io::Write;
+    if let Some(path) = std::env::var_os("CAD_BOX_LOG") {
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let name = std::thread::current().name().unwrap_or("?").to_owned();
+            let _ = writeln!(f, "{line}\ttest={name}");
+        }
+    }
+}
+
+fn review_log<T: Decide>(
+    got: &Result<(), crate::session_box::BoxRefusal<()>>,
+    spec: &EdgeCurveSpec<T>,
+    ends: (Point3<T>, Point3<T>),
+) {
+    use crate::session_box::BoxRefusal;
+    let kind = match got {
+        Ok(()) => return,
+        Err(BoxRefusal::Point { .. }) => "POINT",
+        Err(BoxRefusal::Unshown { .. }) => "UNSHOWN",
+        Err(BoxRefusal::Uncovered(())) => {
+            REVIEW_UNCOVERED.with(|c| c.set(true));
+            "UNCOVERED"
+        }
+    };
+    review_write(&format!(
+        "{kind}\tscalar={}\tcarrier={:?}\tspan=({:?},{:?})\tends={:?}\tgot={:?}",
+        core::any::type_name::<T>(),
+        spec.carrier.kind(),
+        spec.param_start,
+        spec.param_end,
+        ends,
+        got
+    ));
+}
