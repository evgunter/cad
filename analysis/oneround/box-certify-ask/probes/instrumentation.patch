@@ -5251,6 +5295,32 @@ fn run_checks<T: geom_core::Certifies + geom_core::CertifiedBounds>(
     stated: Option<&StatedImage<T>>,
     band: Band,
     kept: &[&LocusCertificate<T>],
+) -> Result<Checked<T>, CertifyError> {
+    REVIEW_UNCOVERED.with(|c| c.set(false));
+    let out = run_checks_real(spec, start, end, surfaces, reach, lane, stated, band, kept);
+    if REVIEW_UNCOVERED.with(|c| c.replace(false)) {
+        review_write(&format!(
+            "UNCOVERED-OUTCOME\t{}",
+            match &out {
+                Ok(_) => "CERTIFIED".to_owned(),
+                Err(e) => format!("refused {e:?}").chars().take(160).collect(),
+            }
+        ));
+    }
+    out
+}
