+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::panic)]
+mod review_probe_travel_offer {
+    use super::{BooleanError, GermArm, Turn, germ_arm};
+    use core::f64::consts::FRAC_PI_4;
+    use geom_core::{Band, Point3, Vec3};
+
+    fn at(k: f64, t: f64) -> (Point3<f64>, Vec3<f64>) {
+        let tangent = Vec3::new(-k * t.sin(), t.cos(), 0.0);
+        (Point3::new(k * t.cos(), t.sin(), 0.0), tangent * (1.0 / tangent.norm()))
+    }
+
+    fn arm(k: f64, band: Band) -> Result<GermArm, BooleanError> {
+        let (germ, dir) = at(k, -FRAC_PI_4);
+        let (site, tangent) = at(k, -FRAC_PI_4 + core::f64::consts::PI);
+        let turn = Turn::<f64>::facing(
+            geom::Line { origin: Point3::origin(), dir: Vec3::unit_z() },
+            (germ, dir * -1.0),
+            (site, tangent),
+            band,
+        )
+        .unwrap();
+        germ_arm(turn, band)
+    }
+
+    /// The half-turn tie at k = 10 escalates under the caller's name and
+    /// offers a tolerance; does that tolerance decide it?
+    #[test]
+    fn review_probe_the_half_turn_ties_offer_is_honoured() {
+        let mut band = Band::new(1e-9, 1e-8).unwrap();
+        for step in 0..4 {
+            match arm(10.0, band) {
+                Err(BooleanError::Escalated { ref diag, .. }) => {
+                    let off = diag.offered_band();
+                    println!(
+                        "step {step}: band ({:e},{:e}) {:?} margin {:?} offers {:?}\n  ending: {}",
+                        band.zero(), band.escalate(), diag.predicate,
+                        diag.margin.diagnostic_f64_for_error_text(), off.map(|b| b.zero()),
+                        diag.ending("L")
+                    );
+                    match off { Some(b) => band = b, None => { println!("no offer"); return; } }
+                }
+                other => { println!("step {step}: band ({:e}) decided ok={}", band.zero(), other.is_ok()); return; }
+            }
+        }
+        panic!("the offered tolerance never decided the tie: four offers in a row re-escalate");
+    }
+}
