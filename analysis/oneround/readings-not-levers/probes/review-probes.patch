+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::panic)]
+mod review_probe_below_the_offer {
+    use super::*;
+    use geom_core::test_support::fixture_lever;
+    use geom_core::{Point3, Vec3};
+
+    /// The arm binds where the wedge reads Zero AT the offer; the
+    /// sentence tells the user to tighten BELOW it. What does a run just
+    /// below (half) the offer read?
+    #[test]
+    fn review_probe_a_wedge_zero_at_the_offer_at_half_the_offer() {
+        let b = Band::new(1e-9, 1e-8).unwrap();
+        let lean = |sin: f64| Surface::<f64>::Plane {
+            frame: geom::Frame::new(
+                Point3::origin(),
+                Vec3::new(0.0, sin, (1.0 - sin * sin).sqrt()),
+                Vec3::unit_x(),
+            ),
+        };
+        let arm = 1.5e-9;
+        let told = b.offer_deciding(arm).unwrap();
+        for share in [0.9, 0.6, 0.3] {
+            let sin = share * told / arm;
+            let first = classify_dihedral(&lean(0.0), &lean(sin), Point3::origin(), fixture_lever(arm), b)
+                .map(|d| d.class());
+            let (pred, offered) = match &first {
+                Err(e) => (e.diag().predicate, e.diag().offered_band()),
+                Ok(c) => panic!("decided {c:?}"),
+            };
+            let below = Band::new(0.5 * told, 0.5 * told * 10.0).unwrap();
+            let second = classify_dihedral(&lean(0.0), &lean(sin), Point3::origin(), fixture_lever(arm), below)
+                .map(|d| d.class());
+            println!(
+                "wedge {:.2} of the told offer {told:e}: first {pred:?} offers {:?}; at half the offer: {:?}",
+                share,
+                offered.map(|o| o.zero()),
+                second.map_err(|e| (e.diag().predicate, e.diag().margin.diagnostic_f64_for_error_text()))
+            );
+        }
+    }
+}
