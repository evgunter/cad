 }
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::panic)]
+mod review_probe_offered_band {
+    use super::*;
+
+    fn refused(margin: MarginDiag, band: Band) -> Indeterminate {
+        Indeterminate { margin, terminal_sliver: false, band, predicate: None }
+    }
+
+    /// Scan margins in band: does the refused margin decide past the
+    /// escalation edge of the band `offered_band` returns (its doc: "at
+    /// or past the escalation edge")?
+    #[test]
+    fn review_probe_refused_margin_decides_in_its_offered_band() {
+        let mut bad = Vec::new();
+        let mut seen = 0u64;
+        for (z, e) in [(1e-9, 1e-8), (1e-9, 7e-9), (1e-12, 1e-11), (1e-6, 1e-5), (3e-9, 1.1e-8)] {
+            let band = Band::new(z, e).unwrap();
+            let mut m = z * 1.000_001;
+            while m < e {
+                for m in [m, m.next_up(), m.next_down()] {
+                    if let Some(off) = refused(MarginDiag::value(m), band).offered_band() {
+                        seen += 1;
+                        let ok = matches!(m.sign_within(off), Ok(Decided { sign: Sign::Positive, .. }));
+                        if !ok && bad.len() < 10 {
+                            bad.push(format!("band ({z:e},{e:e}) m {m:e}: offered ({:e},{:e})", off.zero(), off.escalate()));
+                        }
+                    }
+                }
+                m *= 1.000_37;
+            }
+            // exact grid values: m = K * d, d on the 4-digit grid
+            let k = e / z;
+            for i in 1000..10000 {
+                let d = f64::from(i) * z / 1000.0 / 10.0;
+                let m = d * k;
+                if m <= z || m >= e { continue; }
+                if let Some(off) = refused(MarginDiag::value(m), band).offered_band() {
+                    seen += 1;
+                    let ok = matches!(m.sign_within(off), Ok(Decided { sign: Sign::Positive, .. }));
+                    if !ok && bad.len() < 20 {
+                        bad.push(format!("grid band ({z:e},{e:e}) m {m:e}: offered ({:e},{:e})", off.zero(), off.escalate()));
+                    }
+                }
+            }
+        }
+        println!("seen {seen}");
+        assert!(bad.is_empty(), "{bad:#?}");
+    }
+
+    /// resolved_as old vs new: old Zero ⟺ fl(K·ρ) ≤ ε (K = fl(esc/zero));
+    /// new Zero ⟺ ρ ≤ fl(ε/K) in the finer band. Count disagreements.
+    #[test]
+    fn review_probe_step_finer_vs_k_times() {
+        let mut moved = Vec::new();
+        for (z, e) in [(1e-9, 1e-8), (1e-9, 7e-9), (1e-12, 1e-11), (1e-6, 1e-5), (3e-9, 1.1e-8)] {
+            let band = Band::new(z, e).unwrap();
+            let k = e / z;
+            let finer = band.a_step_finer().unwrap();
+            let edge = finer.zero();
+            let mut r = edge;
+            for _ in 0..64 { r = r.next_down(); }
+            for _ in 0..128 {
+                let old = (k * r).abs() <= z;
+                let new = matches!(r.sign_within(finer), Ok(Decided { sign: Sign::Zero, .. }));
+                if old != new { moved.push(format!("band ({z:e},{e:e}) rho {r:e}: old {old} new {new}")); }
+                r = r.next_up();
+            }
+            // rho*K = eps exactly-ish and rho = eps
+            let r = z / k;
+            println!("band ({z:e},{e:e}) rho=eps/K {r:e}: K*rho {:e} old {} new {:?}", k*r, (k*r) <= z, r.sign_within(finer).map(|d| d.sign));
+            println!("  rho=eps: old {:?} new {:?}", (k*z).sign_within(band).map(|d| d.sign), z.sign_within(finer).map(|d| d.sign));
+        }
+        println!("{moved:#?}");
+    }
+}
