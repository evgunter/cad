+
+/// Review plant 2: the lint allowed under its retired name.
+#[allow(renamed_and_removed_lints)]
+#[allow(clippy::disallowed_method)]
+pub fn review_plant_old_name(c: &geom::Circle<f64>) -> geom_core::Point3<f64> {
+    c.frame().origin()
+}
+
+/// Review plant 3: a whole circle's cover's ball stands at its centre.
+pub fn review_plant_ball(c: &geom::Curve3<f64>) -> Option<geom_core::Point3<f64>> {
+    c.cover_over(geom::cover::ParamWindow::new(0.0, core::f64::consts::TAU))
+        .ok()
+        .map(|cover| cover.ball().0)
+}
