 #[cfg(test)]
 #[path = "cover_reach_rows.rs"]
 mod cover_reach_rows;
+
+/// REVIEW MUTANT SWITCH.
+pub(crate) fn review_mut(name: &str) -> bool {
+    std::env::var("REVIEW_MUT").is_ok_and(|v| v == name)
+}
+/// The bound `want_above` asks for, flipped under mutant `name`.
+pub(crate) fn review_pick<T: Real>(b: geom_brep::LeverBounds<T>, want_above: bool, name: &str) -> geom_core::Lever<T> {
+    if want_above != review_mut(name) { b.above() } else { b.below() }
+}
