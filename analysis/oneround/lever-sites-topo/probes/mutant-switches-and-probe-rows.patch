+/// REVIEW MUTANT SWITCH: `REVIEW_MUT=name`, `REVIEW_K=factor`.
+pub(crate) fn review_mut(name: &str) -> bool {
+    std::env::var("REVIEW_MUT").is_ok_and(|v| v == name)
+}
+pub(crate) fn review_k() -> f64 {
+    std::env::var("REVIEW_K").ok().and_then(|v| v.parse().ok()).unwrap_or(1.0)
+}
+pub(crate) fn review_lever<T: Real>(l: geom_core::Lever<T>, name: &str) -> geom_core::Lever<T> {
+    if review_mut(name) { geom_core::Lever::unsourced(l.length() * T::from_f64(review_k())) } else { l }
+}
+pub(crate) fn review_bounds<T: Real>(b: geom_brep::LeverBounds<T>, name: &str) -> geom_brep::LeverBounds<T> {
+    if review_mut(name) {
+        geom_brep::LeverBounds::Between {
+            below: review_lever(b.below(), name),
+            above: review_lever(b.above(), name),
+        }
+    } else { b }
+}
