+#[allow(clippy::too_many_arguments, clippy::unwrap_used)]
+fn gauge_svc_probe<T: Decide>(
+    plans: &[NullPlan<T>],
+    others: &[usize],
+    i: usize,
+    k: usize,
+    slot: usize,
+    secs: &[BoolSector<T>],
+    cuts: &[OtherCut<T>],
+    band: Band,
+) {
+    let code = |c: SideCode| match c {
+        SideCode::In => "I",
+        SideCode::Out => "O",
+        SideCode::On => "N",
+    };
+    let mut labels: Vec<(Cut<T>, String)> = Vec::new();
+    let mut runs_desc = Vec::new();
+    let mut plan_ids: Vec<usize> = vec![i];
+    plan_ids.extend_from_slice(others);
+    for &p in &plan_ids {
+        for (r, run) in plans[p].runs.iter().enumerate() {
+            let run = run[slot];
+            let (lo, hi, c) = segment(secs, run, band).unwrap();
+            let strut = is_strut(secs, run.from.cut.entry, run.to.cut.entry).unwrap();
+            runs_desc.push(format!(
+                "p{p}.{r}:{}{}[{}..{}]{}",
+                if strut { "S" } else { "F" },
+                code(c),
+                lo.entry,
+                hi.entry,
+                if p == i && r == k { "*" } else { "" }
+            ));
+            labels.push((lo, format!("p{p}.{r}<{}", lo.entry)));
+            labels.push((hi, format!("p{p}.{r}>{}", hi.entry)));
+        }
+    }
+    let mut order: Vec<usize> = Vec::new();
+    for x in 0..labels.len() {
+        let mut at = order.len();
+        for (q, &y) in order.iter().enumerate() {
+            if walks_before(secs, labels[x].0, labels[y].0, band).unwrap() == Some(true) {
+                at = q;
+                break;
+            }
+        }
+        order.insert(at, x);
+    }
+    let mut seq = Vec::new();
+    for (q, &x) in order.iter().enumerate() {
+        let tie = q > 0 && walks_before(secs, labels[order[q - 1]].0, labels[x].0, band).unwrap().is_none();
+        seq.push(format!("{}{}", if tie { "=" } else { "" }, labels[x].1));
+    }
+    let current = plans[i].runs[k][slot];
+    let ways: Vec<String> = [current, current.reversed()]
+        .into_iter()
+        .map(|run| {
+            if spelled_reversed(secs, run.from.cut.entry, run.to.cut.entry).unwrap() {
+                return "skip".to_string();
+            }
+            match held_cut(secs, run, cuts, band) {
+                Ok(Some(j)) => format!("p{j}"),
+                Ok(None) => "clear".to_string(),
+                Err(e) => format!("err:{e:?}"),
+            }
+        })
+        .collect();
+    let phys = secs.iter().filter(|s| s.end_edge()).count();
+    eprintln!(
+        "GAUGE-SVC-PROBE slot={slot} plans={} secs={} phys={phys} runs=[{}] ways=[{}] seq=[{}]",
+        plan_ids.len(),
+        secs.len(),
+        runs_desc.join(" "),
+        ways.join(","),
+        seq.join(" ")
+    );
+}
