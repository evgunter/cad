+/// REVIEW PROBE: appends one line to the file `RSS_ROOT_TRACE` names.
+fn rss_trace(what: &str) {
+    use std::io::Write as _;
+    let Some(path) = std::env::var_os("RSS_ROOT_TRACE") else { return };
+    let bt = std::backtrace::Backtrace::force_capture().to_string();
+    let name = |l: &str| -> Option<String> {
+        let l = l.split_once(": ").map_or(l, |(_, r)| r);
+        (!l.starts_with("at ")).then(|| l.chars().take(80).collect())
+    };
+    let lines: Vec<String> = bt.lines().map(str::trim).filter_map(name).collect();
+    let kernel: Vec<&str> = lines
+        .iter()
+        .map(String::as_str)
+        .filter(|l| l.contains("sweep::") || l.contains("topo::") || l.contains("verbs::") || l.contains("profile::"))
+        .take(3)
+        .collect();
+    let editor: Vec<&str> = lines
+        .iter()
+        .map(String::as_str)
+        .filter(|l| l.contains("editor_core::"))
+        .take(10)
+        .collect();
+    let thread = std::thread::current();
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(
+            f,
+            "{what} | {} | {} | {}",
+            thread.name().unwrap_or("?"),
+            kernel.join(" < "),
+            editor.join(" < ")
+        );
+    }
+}
