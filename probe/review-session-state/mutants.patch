+/// REVIEW PROBE: whether the named mutant is switched on in this process.
+pub(crate) fn rss(name: &str) -> bool {
+    std::env::var_os(name).is_some()
+}
+
+/// REVIEW PROBE: appends one line to the file `RSS_ROOT_TRACE` names.
+fn rss_trace(what: &str) {
+    use std::io::Write as _;
+    let Some(path) = std::env::var_os("RSS_ROOT_TRACE") else { return };
+    let bt = std::backtrace::Backtrace::force_capture().to_string();
+    let frames: Vec<&str> = bt
+        .lines()
+        .map(str::trim)
+        .filter(|l| l.contains("editor_core::") || l.contains("sweep::") || l.contains("topo::") || l.contains("verbs::"))
+        .take(14)
+        .collect();
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{what} | {}", frames.join(" < "));
+    }
+}
